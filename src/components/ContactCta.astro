---
// Plain contact section on light pages (bios, galleries). Live has no eyebrow
// by default and a plain CONTACT US button.
import { url } from "../lib/site";
interface Props {
	eyebrow?: string;
	heading?: string;
	line?: string;
	button?: string;
	tone?: "light" | "dark";
}
const { eyebrow = "", heading = "Get in touch for further inquiries", line, button = "Contact Us", tone = "light" } = Astro.props;
---

<section class:list={["ccta", `ccta--${tone}`]}>
	{eyebrow && <p class="eyebrow e" data-reveal>{eyebrow}</p>}
	<h2 class="t" data-reveal style="--d:80ms">{heading}</h2>
	{line && <p class="l" data-reveal style="--d:160ms">{line}</p>}
	<a class="btn-outline" href={url("/contact")} data-reveal style="--d:200ms">{button}</a>
</section>

<style>
	.ccta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		padding: 110px 32px;
		text-align: center;
	}
	.ccta--light {
		color: var(--charcoal);
	}
	.ccta--dark {
		color: var(--paper);
	}
	.t {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: var(--t-cta);
		line-height: 1.15;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}
	.e {
		color: var(--taupe);
	}
	.ccta--dark .e {
		color: var(--sand);
	}
	.l {
		max-inline-size: 560px;
		opacity: 0.8;
	}
	.btn-outline {
		margin-block-start: 8px;
	}
</style>
