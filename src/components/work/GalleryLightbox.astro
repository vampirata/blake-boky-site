---
// Gallery grid + full screen lightbox (port of the Framer GalleryLightbox code
// component). Tiles are a fixed 2:3 frame with the image contained on the page
// colour, so nothing is cut. The lightbox shows the whole image, steps with wrap,
// swipes on touch, locks page scroll, traps focus and hands it back to the tile.
import Img from "../Img.astro";
import { img } from "../../lib/img";
import type { ImageRec } from "../../lib/data";

interface Props {
	images: ImageRec[];
	title: string;
	/** Columns per breakpoint, from the Framer instance props. */
	cols?: { desktop: number; tablet: number; phone: number };
	/** Tile frame colour (the section background). */
	bg?: string;
}
const { images, title, cols = { desktop: 3, tablet: 3, phone: 2 }, bg = "var(--stone)" } = Astro.props;
const n = images.length;
const tileSizes = (c: number) => `${Math.ceil(100 / c)}vw`;
const sizes = `(min-width: 1400px) ${tileSizes(cols.desktop)}, (min-width: 810px) ${tileSizes(cols.tablet)}, ${tileSizes(cols.phone)}`;
const full = images.map((im) => img(im.src));
---

{
	n > 0 && (
		<div class="gallery" data-gallery style={`--c-d:${cols.desktop};--c-t:${cols.tablet};--c-p:${cols.phone}`}>
			<ul class="grid" role="list">
				{images.map((im, i) => (
					<li>
						<button type="button" class="tile" data-open={i} aria-label={`Open image ${i + 1} of ${n}`} aria-haspopup="dialog">
							<Img src={im.src} alt={im.alt ?? ""} ratio="9 / 16" bg={bg} sizes={sizes} />
						</button>
					</li>
				))}
			</ul>

			<dialog class="lb" aria-label={`${title}: images`}>
				<div class="lb-stage" data-stage>
					<ul class="lb-track" role="list" data-track>
						{images.map((im, i) => (
							<li class="lb-slide" aria-hidden="true">
								<img
									data-src={full[i]?.src}
									data-srcset={full[i]?.srcset}
									sizes="100vw"
									width={full[i]?.width}
									height={full[i]?.height}
									alt={im.alt || `${title}, image ${i + 1} of ${n}`}
									style={full[i]?.width ? `--nw:${full[i].width}px;--nh:${full[i].height}px` : undefined}
									decoding="async"
									draggable="false"
								/>
							</li>
						))}
					</ul>
				</div>
				{n > 1 && (
					<button type="button" class="lb-btn lb-prev" data-step="-1" aria-label="Previous image">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M15 5l-7 7 7 7" />
						</svg>
					</button>
				)}
				{n > 1 && (
					<button type="button" class="lb-btn lb-next" data-step="1" aria-label="Next image">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M9 5l7 7-7 7" />
						</svg>
					</button>
				)}
				<button type="button" class="lb-btn lb-close" data-close aria-label="Close">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M6 6l12 12M18 6L6 18" />
					</svg>
				</button>
				<p class="lb-count" aria-live="polite" data-count>
					1 / {n}
				</p>
			</dialog>
		</div>
	)
}

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(var(--c-d), minmax(0, 1fr));
		gap: 16px;
	}
	@media (max-width: 1399.98px) {
		.grid {
			grid-template-columns: repeat(var(--c-t), minmax(0, 1fr));
		}
	}
	@media (max-width: 809.98px) {
		.grid {
			grid-template-columns: repeat(var(--c-p), minmax(0, 1fr));
		}
	}
	.tile {
		display: block;
		inline-size: 100%;
		cursor: zoom-in;
		outline: 1px solid transparent;
		transition: outline-color 260ms ease;
	}
	.tile:hover {
		outline-color: var(--gold-light);
	}
	.tile:focus-visible {
		outline: 1px solid var(--gold-light);
		outline-offset: 0;
	}
	.tile :global(.art img) {
		transition: transform 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
	}
	.tile:hover :global(.art img) {
		transform: scale(1.04);
	}

	/* Lightbox */
	.lb {
		position: fixed;
		inset: 0;
		inline-size: 100vw;
		block-size: 100vh;
		block-size: 100dvh;
		max-inline-size: none;
		max-block-size: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(10, 10, 10, 0.94);
		color: rgba(240, 238, 232, 0.9);
		overflow: hidden;
		overscroll-behavior: contain;
	}
	.lb[open] {
		animation: lb-in 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
	}
	.lb[open] .lb-stage {
		animation: lb-zoom 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
	}
	.lb.is-closing {
		animation: lb-out 220ms cubic-bezier(0.4, 0, 1, 1) forwards;
	}
	.lb.is-closing .lb-stage {
		animation: lb-zoom-out 220ms cubic-bezier(0.4, 0, 1, 1) forwards;
	}
	.lb::backdrop {
		background: transparent;
	}
	@keyframes lb-in {
		from {
			opacity: 0;
		}
	}
	@keyframes lb-out {
		to {
			opacity: 0;
		}
	}
	@keyframes lb-zoom {
		from {
			scale: 0.96;
		}
	}
	@keyframes lb-zoom-out {
		to {
			scale: 0.97;
		}
	}
	.lb-stage {
		position: absolute;
		inset: 88px clamp(84px, calc(4vw + 68px), 124px) 72px;
		overflow: hidden;
		touch-action: pan-y pinch-zoom;
		cursor: grab;
	}
	.lb-stage.is-dragging {
		cursor: grabbing;
	}
	.lb-track {
		display: flex;
		block-size: 100%;
		transition: transform 560ms cubic-bezier(0.22, 0.61, 0.36, 1);
		will-change: transform;
	}
	.lb-track.no-anim {
		transition: none;
	}
	.lb-slide {
		flex: 0 0 100%;
		block-size: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.lb-slide img {
		/* Fill the stage, but never blow a small original up past 1.5x. */
		inline-size: min(100%, calc(var(--nw, 9999px) * 1.5));
		block-size: min(100%, calc(var(--nh, 9999px) * 1.5));
		object-fit: contain;
		user-select: none;
		-webkit-user-drag: none;
	}
	.lb-btn {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		inline-size: 52px;
		block-size: 52px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		border: 1px solid rgba(240, 238, 232, 0.9);
		color: rgba(240, 238, 232, 0.9);
		transition:
			background 240ms ease,
			color 240ms ease,
			border-color 240ms ease,
			scale 140ms ease;
	}
	.lb-btn svg {
		inline-size: 22px;
		block-size: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
	}
	.lb-btn:hover {
		background: var(--gold-light);
		border-color: var(--gold-light);
		color: rgb(20, 19, 17);
	}
	.lb-btn:active {
		scale: 0.92;
	}
	.lb-prev {
		left: clamp(16px, 4vw, 56px);
	}
	.lb-next {
		right: clamp(16px, 4vw, 56px);
	}
	.lb-close {
		top: 32px;
		right: clamp(16px, 4vw, 56px);
		translate: none;
		inline-size: 44px;
		block-size: 44px;
	}
	.lb-count {
		position: absolute;
		bottom: 30px;
		left: 0;
		right: 0;
		text-align: center;
		font-family: var(--font-body);
		font-weight: 300;
		font-size: 12px;
		line-height: 1.2;
		letter-spacing: 0.18em;
		pointer-events: none;
	}
	@media (max-width: 809.98px) {
		.lb-stage {
			inset: 92px 0 108px;
		}
		.lb-prev,
		.lb-next {
			top: auto;
			bottom: 18px;
			translate: none;
			inline-size: 48px;
			block-size: 48px;
		}
		.lb-close {
			top: 24px;
		}
		.lb-count {
			bottom: 36px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.lb[open],
		.lb[open] .lb-stage,
		.lb.is-closing,
		.lb.is-closing .lb-stage {
			animation: none;
		}
		.lb-track {
			transition: none;
		}
	}
</style>

<script>
	type Lenisish = { stop(): void; start(): void } | null | undefined;

	function init(root: HTMLElement) {
		const dlg = root.querySelector<HTMLDialogElement>("dialog");
		const stage = root.querySelector<HTMLElement>("[data-stage]");
		const track = root.querySelector<HTMLElement>("[data-track]");
		const count = root.querySelector<HTMLElement>("[data-count]");
		if (!dlg || !stage || !track || !count) return;
		const slides = Array.from(track.children) as HTMLElement[];
		const n = slides.length;
		let index = 0;
		let opener: HTMLElement | null = null;

		const load = (i: number) => {
			const im = slides[(i + n) % n]?.querySelector("img");
			if (!im || im.getAttribute("src")) return;
			if (im.dataset.srcset) im.srcset = im.dataset.srcset;
			if (im.dataset.src) im.src = im.dataset.src;
		};
		const show = (i: number, animate = true) => {
			index = ((i % n) + n) % n;
			track.classList.toggle("no-anim", !animate);
			track.style.transform = `translate3d(${-index * 100}%,0,0)`;
			slides.forEach((s, k) => s.setAttribute("aria-hidden", String(k !== index)));
			count.textContent = `${index + 1} / ${n}`;
			load(index);
			load(index + 1);
			load(index - 1);
		};
		const lenis = () => (window as unknown as { __lenis?: Lenisish }).__lenis;
		const html = document.documentElement;
		const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

		const open = (i: number, from: HTMLElement) => {
			opener = from;
			show(i, false);
			// Lock the page (and smooth scroll) without the layout jumping where
			// the scrollbar was.
			const bar = innerWidth - html.clientWidth;
			html.style.overflow = "hidden";
			if (bar > 0) html.style.paddingInlineEnd = `${bar}px`;
			lenis()?.stop();
			dlg.classList.remove("is-closing");
			dlg.showModal();
			dlg.querySelector<HTMLElement>("[data-close]")?.focus({ preventScroll: true });
		};
		let closing = false;
		const close = () => {
			if (!dlg.open || closing) return;
			if (reduce()) return dlg.close();
			closing = true;
			dlg.classList.add("is-closing");
			const done = () => {
				clearTimeout(t);
				dlg.removeEventListener("animationend", onEnd);
				closing = false;
				dlg.classList.remove("is-closing");
				dlg.close();
			};
			const onEnd = (e: AnimationEvent) => e.target === dlg && done();
			const t = setTimeout(done, 400);
			dlg.addEventListener("animationend", onEnd);
		};
		dlg.addEventListener("close", () => {
			html.style.overflow = "";
			html.style.paddingInlineEnd = "";
			lenis()?.start();
			opener?.focus({ preventScroll: true });
		});
		dlg.addEventListener("cancel", (e) => {
			e.preventDefault();
			close();
		});

		root.querySelectorAll<HTMLElement>("[data-open]").forEach((b) =>
			b.addEventListener("click", () => open(Number(b.dataset.open), b))
		);
		dlg.querySelectorAll<HTMLElement>("[data-step]").forEach((b) =>
			b.addEventListener("click", () => show(index + Number(b.dataset.step)))
		);
		dlg.querySelector("[data-close]")?.addEventListener("click", close);
		// A click on the dark surround (outside the stage and the buttons) closes too.
		dlg.addEventListener("click", (e) => {
			if (e.target === dlg) close();
		});

		dlg.addEventListener("keydown", (e) => {
			if (e.key === "ArrowRight") {
				e.preventDefault();
				show(index + 1);
			} else if (e.key === "ArrowLeft") {
				e.preventDefault();
				show(index - 1);
			} else if (e.key === "Tab") {
				// Keep focus on the viewer's own controls.
				const f = Array.from(dlg.querySelectorAll<HTMLElement>("button"));
				const at = f.indexOf(document.activeElement as HTMLElement);
				e.preventDefault();
				const next = e.shiftKey ? (at <= 0 ? f.length - 1 : at - 1) : at >= f.length - 1 ? 0 : at + 1;
				f[next]?.focus();
			}
		});

		const onPicture = (im: HTMLImageElement, x: number, y: number) => {
			const r = im.getBoundingClientRect();
			const nw = im.naturalWidth || Number(im.getAttribute("width")) || r.width;
			const nh = im.naturalHeight || Number(im.getAttribute("height")) || r.height;
			const k = Math.min(r.width / nw, r.height / nh);
			const w = nw * k;
			const h = nh * k;
			const left = r.left + (r.width - w) / 2;
			const top = r.top + (r.height - h) / 2;
			return x >= left && x <= left + w && y >= top && y <= top + h;
		};

		// Swipe / drag between images. A tap outside the image closes.
		let startX = 0;
		let startY = 0;
		let dx = 0;
		let t0 = 0;
		let pid = -1;
		stage.addEventListener("pointerdown", (e) => {
			if (e.pointerType === "mouse" && e.button !== 0) return;
			pid = e.pointerId;
			startX = e.clientX;
			startY = e.clientY;
			dx = 0;
			t0 = performance.now();
			try {
				stage.setPointerCapture(e.pointerId);
			} catch {}
		});
		stage.addEventListener("pointermove", (e) => {
			if (e.pointerId !== pid) return;
			dx = e.clientX - startX;
			if (n < 2 || Math.abs(dx) < 4) return;
			stage.classList.add("is-dragging");
			track.classList.add("no-anim");
			track.style.transform = `translate3d(calc(${-index * 100}% + ${dx}px),0,0)`;
		});
		const end = (e: PointerEvent) => {
			if (e.pointerId !== pid) return;
			pid = -1;
			stage.classList.remove("is-dragging");
			const dy = e.clientY - startY;
			const fast = Math.abs(dx) / Math.max(performance.now() - t0, 1) > 0.4;
			if (Math.abs(dx) < 6 && Math.abs(dy) < 6 && e.type === "pointerup") {
				show(index, true);
				// Close on a tap outside the picture itself (the contained image
				// leaves empty bands inside its own box).
				const im = slides[index]?.querySelector("img");
				if (!im || !onPicture(im, e.clientX, e.clientY)) close();
				return;
			}
			if (n > 1 && (Math.abs(dx) > stage.clientWidth * 0.18 || (fast && Math.abs(dx) > 30))) show(index + (dx < 0 ? 1 : -1));
			else show(index);
		};
		stage.addEventListener("pointerup", end);
		stage.addEventListener("pointercancel", end);
	}

	document.querySelectorAll<HTMLElement>("[data-gallery]").forEach(init);
</script>
