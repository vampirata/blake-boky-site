---
// Pre-footer band on dark pages: full-bleed photo, heading, black Contact Us button.
import Img from "./Img.astro";
import { url } from "../lib/site";
interface Props {
	image: string;
	pos?: string;
	heading?: string;
}
const { image, pos = "50% 50%", heading = "Get in touch for further inquiries" } = Astro.props;
---

<section class="cta">
	<Img src={image} fit="cover" pos={pos} class="bg" sizes="100vw" />
	<div class="inner">
		<h2 class="h2 t" data-reveal>{heading}</h2>
		<a class="btn" href={url("/contact")} data-reveal style="--d:120ms">
			<span>Contact Us</span>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 13h12.17l-5.59 5.59L12 20l8-8-8-8-1.41 1.41L16.17 11H4v2z"></path></svg>
		</a>
	</div>
</section>

<style>
	.cta {
		position: relative;
		display: grid;
		place-items: center;
		min-block-size: 638px;
		padding: 250px 20px;
		overflow: hidden;
	}
	.cta :global(.bg) {
		position: absolute;
		inset: 0;
		aspect-ratio: auto;
	}
	.inner {
		position: relative;
		inline-size: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 25px;
		text-align: center;
	}
	.t {
		color: var(--black);
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 0 16px;
		block-size: 54px;
		background: var(--black);
		color: var(--white);
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: 24px;
		line-height: 1.4;
		letter-spacing: -0.02em;
		transition:
			background-color 300ms var(--ease-out),
			padding 300ms var(--ease-out);
	}
	.btn svg {
		inline-size: 21px;
		block-size: 21px;
		color: var(--hairline);
	}
	.btn:hover {
		background: var(--hover-grey);
		padding-inline: 18px 19px;
	}
	@media (max-width: 1399.98px) {
		.cta {
			padding: 250px 40px;
			min-block-size: 627px;
		}
		.btn {
			font-size: 21px;
		}
	}
	@media (max-width: 809.98px) {
		.cta {
			padding: 200px 20px;
			min-block-size: 554px;
		}
		.btn {
			font-size: 18px;
		}
	}
</style>
