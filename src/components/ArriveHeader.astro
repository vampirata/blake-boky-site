---
// List-page header: the title (Inter 300 26px, split per character on live)
// rises in after load, full-width hairline below.
import SplitTitle from "./SplitTitle.astro";
interface Props {
	title: string;
	tone?: "dark" | "light";
	as?: string;
}
const { title, tone = "dark", as = "h1" } = Astro.props;
---

<header class:list={["arrive", `arrive--${tone}`]}>
	<div data-arrive>
		<slot name="before" />
		<SplitTitle text={title} as={as} class="arrive-title" />
		<slot />
	</div>
</header>
<hr class:list={["rule", `rule--${tone}`]} />

<style>
	.arrive {
		padding: 150px var(--gutter) 20px;
		overflow: hidden;
	}
	.arrive :global(.arrive-title) {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: 26px;
		line-height: 1.4;
		letter-spacing: -0.02em;
	}
	.arrive--light {
		color: var(--charcoal);
	}
	.rule {
		margin: 0;
		border: 0;
		block-size: 1px;
		background: var(--grey-363);
	}
	.rule--light {
		background: var(--hairline);
	}
	@media (max-width: 809.98px) {
		.arrive {
			padding-inline: 12px;
		}
	}
</style>
