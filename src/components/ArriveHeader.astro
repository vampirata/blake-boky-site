---
// List-page header: title rises in after load, full-width hairline below.
interface Props {
	title: string;
	tone?: "dark" | "light";
}
const { title, tone = "dark" } = Astro.props;
---

<header class:list={["arrive", `arrive--${tone}`]}>
	<div data-arrive>
		<slot name="before" />
		<h1 class="h2">{title}</h1>
		<slot />
	</div>
</header>
<hr class:list={["rule", `rule--${tone}`]} />

<style>
	.arrive {
		padding: 150px var(--gutter) 20px;
		overflow: hidden;
	}
	.arrive h1 {
		line-height: 1.1;
	}
	.arrive--light {
		color: var(--charcoal);
	}
	.rule {
		margin: 0;
		border: 0;
		block-size: 1px;
		background: var(--grey-363);
	}
	.rule--light {
		background: var(--hairline);
	}
	@media (max-width: 809.98px) {
		.arrive {
			padding-inline: 12px;
		}
	}
</style>
