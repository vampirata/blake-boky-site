---
// Card titles reveal one character at a time on scroll (live site behaviour).
// Characters are grouped per word so lines still wrap between words.
interface Props {
	text: string;
	as?: string;
	class?: string;
}
const { text, as: Tag = "h3", class: cls = "" } = Astro.props;
let i = 0;
const words = text.split(" ").map((w) => [...w].map((c) => ({ c, i: i++ })));
// The whole title lands within about 700 ms however long it is: 50 ms per letter,
// tightened for long titles.
const step = Math.min(50, 700 / Math.max(1, i)).toFixed(1);
---

<Tag class:list={["split", cls]} data-split aria-label={text} style={`--step:${step}ms`}>
	{
		words.map((w, wi) => (
			<>
				<span class="w" aria-hidden="true">
					{w.map(({ c, i }) => (
						<span class="ch" style={`--i:${i}`}>
							{c}
						</span>
					))}
				</span>
				{wi < words.length - 1 ? " " : ""}
			</>
		))
	}
</Tag>

<style>
	.w {
		display: inline-block;
		white-space: nowrap;
	}
</style>
