---
// Every content image goes through here.
// - No ratio: the frame takes the image's own ratio (nothing is cut).
// - ratio (+ ratioTablet / ratioPhone for frames that change shape per
//   breakpoint): a fixed grid frame filled by smartFill(), which crops only
//   empty backdrop, otherwise shows the whole piece on its own edge colours or
//   a blurred copy, so grids stay even without cutting the artwork.
// - fit="cover" with pos: atmosphere images (banners, CTA backgrounds).
// - fit="contain": force the whole image on bg.
// - data-src carries the original asset path so page transitions can pair the
//   same artwork across pages (scripts/motion.ts). parallax / noWipe are motion opt-ins.
import { img } from "../lib/img";
import { smartFill, type Fill } from "../lib/fit";

interface Props {
	src: string;
	alt?: string;
	sizes?: string;
	ratio?: string;
	ratioTablet?: string;
	ratioPhone?: string;
	fit?: "contain" | "cover" | "smart";
	pos?: string;
	bg?: string;
	zoom?: boolean;
	eager?: boolean;
	/** Scroll-linked drift for large atmosphere images (fit="cover" only). */
	parallax?: boolean;
	/** Skip the scroll wipe for this image. */
	noWipe?: boolean;
	class?: string;
	style?: string;
}
const {
	src,
	alt = "",
	sizes = "100vw",
	ratio,
	ratioTablet,
	ratioPhone,
	fit = ratio ? "smart" : "contain",
	pos,
	bg,
	zoom = false,
	eager = false,
	parallax = false,
	noWipe = false,
	class: cls = "",
	style = "",
} = Astro.props;
const r = img(src);
const own = r?.width && r?.height ? `${r.width} / ${r.height}` : undefined;

const vars: string[] = [];
let blurSrc = "";
const put = (suffix: string, frame: string | undefined) => {
	if (!frame) return;
	vars.push(`--ratio${suffix}:${frame}`);
	let f: Fill;
	if (fit === "smart") f = smartFill(src, r?.ratio, frame, bg);
	else f = { fit: fit === "cover" ? "cover" : "contain", pos: pos ?? "50% 50%", fill: bg ?? "transparent", blur: false };
	if (pos && fit === "smart" && f.fit === "cover") f.pos = pos;
	vars.push(`--fit${suffix}:${f.fit}`, `--pos${suffix}:${f.pos}`, `--fill${suffix}:${f.fill}`, `--blur${suffix}:${f.blur ? 1 : 0}`, `--mask${suffix}:${f.mask ?? "none"}`);
	if (f.blur && r?.srcset) blurSrc = r.srcset.split(",")[0].trim().split(" ")[0];
};
put("", ratio ?? own ?? "auto");
put("-t", ratioTablet);
put("-p", ratioPhone);
if (blurSrc) vars.push(`--blur-src:url("${blurSrc}")`);
if (style) vars.push(style);
---

<div
	class:list={["art", zoom && "art--zoom", cls]}
	style={vars.join(";")}
	data-rt={ratioTablet ? "" : undefined}
	data-rp={ratioPhone ? "" : undefined}
	data-src={src.split("?")[0]}
	data-parallax={parallax ? "" : undefined}
	data-no-wipe={noWipe ? "" : undefined}
>
	{
		r && (
			<img
				src={r.src}
				srcset={r.srcset}
				sizes={sizes}
				width={r.width}
				height={r.height}
				alt={alt}
				loading={eager ? "eager" : "lazy"}
				decoding="async"
				fetchpriority={eager ? "high" : undefined}
			/>
		)
	}
</div>
