---
// Fullscreen photo of Blake at work: 100vh frame (sticky on desktop), image 120% tall,
// the next section slides over it like a curtain. The focal point keeps
// Blake's face and hands in frame on tablet and phone.
import Img from "../Img.astro";
interface Props {
	src: string;
	alt?: string;
}
const { src, alt = "" } = Astro.props;
---

<figure class="full" data-sticky>
	<Img src={src} alt={alt} fit="cover" pos="var(--focal)" sizes="100vw" class="pic" />
</figure>

<style>
	.full {
		--focal: 50% 50%;
		position: relative;
		block-size: 100vh;
		block-size: 100svh;
		overflow: hidden;
		background: var(--black);
	}
	.full :global(.pic) {
		position: absolute;
		inset-inline: 0;
		top: -10%;
		block-size: 120%;
		aspect-ratio: auto;
	}
	/* Curtain (sticky) only on desktop, as live. */
	@media (min-width: 1400px) {
		.full {
			position: sticky;
			top: 0;
		}
	}
	@media (max-width: 1399.98px) {
		.full {
			--focal: 60% 45%;
		}
	}
	@media (max-width: 809.98px) {
		.full {
			--focal: 62% 45%;
		}
	}
</style>
