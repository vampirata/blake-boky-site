---
// One half of "About the Artists": link bar, eyebrow, name, italic subtitle,
// portrait, paragraph, hairline, collections list and outlined CTA.
import Img from "../Img.astro";
import SectionBar from "./SectionBar.astro";
import { url } from "../../lib/site";

interface Props {
	tone: "paper" | "ink";
	href: string;
	barLabel: string;
	eyebrow: string;
	name: string;
	subtitle: string;
	portrait: { src: string; alt?: string };
	portraitPos?: string;
	text: string;
	listLabel: string;
	list: string;
	cta: string;
}
const p = Astro.props;
const paper = p.tone === "paper";
---

<div class:list={["half", `half--${p.tone}`]}>
	<SectionBar
		href={p.href}
		label={p.barLabel}
		bg={paper ? "var(--paper)" : "var(--ink)"}
		fg={paper ? "var(--ink)" : "var(--hairline)"}
		hoverBg={paper ? "var(--gold-light)" : "var(--gold)"}
	/>
	<div class="body">
		<p class="eyebrow eb" data-reveal>{p.eyebrow}</p>
		<h2 class="display name" data-reveal>{p.name}</h2>
		<p class="subtitle sub" data-reveal>{p.subtitle}</p>
		<div class="portrait" data-reveal>
			<Img src={p.portrait.src} alt={p.portrait.alt ?? ""} ratio="1 / 1" fit="cover" pos={p.portraitPos} sizes="(min-width: 1400px) 380px, 330px" />
		</div>
		<p class="txt" data-reveal>{p.text}</p>
		<div class="foot" data-reveal>
			<p class="micro ll">{p.listLabel}</p>
			<p class="list">{p.list}</p>
			<a class="cta" href={url(p.href)}>{p.cta.replace(/\s*→\s*$/, "")}<span class="arw" aria-hidden="true">→</span></a>
		</div>
	</div>
</div>

<style>
	.half {
		display: flex;
		flex-direction: column;
		min-inline-size: 0;
	}
	.half--paper {
		background: var(--paper);
		color: var(--charcoal);
		--muted: var(--taupe);
		--rule: var(--hairline);
		--cta-hover: var(--gold-light);
	}
	.half--ink {
		background: var(--ink);
		color: var(--paper);
		--muted: var(--sand);
		--rule: var(--grey-363);
		--cta-hover: var(--gold);
	}
	.body {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 34px 24px 100px;
	}
	.eb {
		color: var(--muted);
	}
	.half--ink .eb {
		color: var(--hairline);
	}
	.name {
		margin-block-start: 22px;
		line-height: 1.04;
	}
	.sub {
		margin-block-start: 22px;
		color: var(--muted);
	}
	.portrait {
		inline-size: 380px;
		max-inline-size: 100%;
		margin-block-start: 54px;
	}
	.portrait :global(.art) {
		border-radius: 2px;
	}
	.txt {
		max-inline-size: 440px;
		margin-block: 54px 50px;
		font-size: 15px;
		line-height: 24px;
		letter-spacing: 0;
		color: var(--muted);
	}
	.foot {
		inline-size: 100%;
		max-inline-size: 440px;
		margin-block-start: auto;
		padding-block-start: 20px;
		border-block-start: 1px solid var(--rule);
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.ll {
		color: var(--muted);
	}
	.list {
		margin-block-start: 12px;
		font-family: var(--font-display);
		font-size: 18px;
		line-height: 1.4;
		letter-spacing: 0;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		min-inline-size: 300px;
		min-block-size: 71px;
		margin-block-start: 26px;
		padding: 12px 30px;
		border: 1px solid currentColor;
		font-family: var(--font-display);
		font-size: 26px;
		line-height: 1.3;
		letter-spacing: -0.01em;
		transition: background-color 400ms var(--ease-out);
	}
	.arw {
		font-family: var(--font-body);
		font-size: 20px;
		line-height: 1;
	}
	.cta:hover {
		background: var(--cta-hover);
	}
	.half--ink .cta:hover {
		color: var(--ink);
		border-color: var(--gold);
	}
	@media (max-width: 1399.98px) {
		.portrait {
			inline-size: 320px;
		}
		.txt,
		.foot {
			max-inline-size: 340px;
		}
		.body {
			padding-inline: 22px;
		}
	}
	@media (max-width: 809.98px) {
		.portrait {
			inline-size: 326px;
		}
		.txt,
		.foot {
			max-inline-size: 330px;
		}
		.body {
			padding-block-end: 80px;
		}
		.cta {
			min-inline-size: 220px;
			min-block-size: 60px;
			font-size: 22px;
		}
	}
</style>
