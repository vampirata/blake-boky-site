---
// One half of "About the Artists": link bar, eyebrow, name, italic subtitle,
// portrait, paragraph, hairline, collections list and outlined CTA.
import Img from "../Img.astro";
import SectionBar from "./SectionBar.astro";
import { url } from "../../lib/site";

interface Props {
	tone: "paper" | "ink";
	href: string;
	barLabel: string;
	eyebrow: string;
	name: string;
	subtitle: string;
	portrait: { src: string; alt?: string };
	portraitPos?: string;
	text: string;
	listLabel: string;
	list: string;
	cta: string;
}
const p = Astro.props;
const paper = p.tone === "paper";
---

<div class:list={["half", `half--${p.tone}`]}>
	<SectionBar
		href={p.href}
		label={p.barLabel}
		bg={paper ? "var(--paper)" : "var(--ink)"}
		fg={paper ? "var(--ink)" : "var(--hairline)"}
		hoverBg={paper ? "var(--gold-light)" : "var(--gold)"}
	/>
	<div class="body">
		<p class="eyebrow eb" data-reveal>{p.eyebrow}</p>
		<h2 class="display name" data-reveal>{p.name}</h2>
		<p class="subtitle sub" data-reveal>{p.subtitle}</p>
		<div class="portrait" data-reveal>
			<Img src={p.portrait.src} alt={p.portrait.alt ?? ""} ratio="1 / 1" fit="cover" pos={p.portraitPos} sizes="(min-width: 1400px) 380px, 330px" />
		</div>
		<p class="txt" data-reveal>{p.text}</p>
		<div class="foot" data-reveal>
			<p class="micro ll">{p.listLabel}</p>
			<p class="list">{p.list}</p>
			<a class="cta" href={url(p.href)}>{p.cta.replace(/\s*→\s*$/, "")} <span aria-hidden="true">→</span></a>
		</div>
	</div>
</div>

<style>
	.half {
		display: flex;
		flex-direction: column;
		min-inline-size: 0;
	}
	.half--paper {
		background: var(--paper);
		color: var(--charcoal);
		--muted: var(--taupe);
		--rule: var(--hairline);
		--cta-hover: var(--gold-light);
	}
	.half--ink {
		background: var(--ink);
		color: var(--paper);
		--muted: var(--sand);
		--rule: var(--grey-363);
		--cta-hover: var(--gold);
	}
	.body {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 32px 32px 100px;
	}
	.eb {
		color: var(--muted);
	}
	.half--ink .eb {
		color: var(--paper);
	}
	.name {
		margin-block-start: 26px;
		/* Live 0.98; nothing above clips it (no overflow hidden). */
		line-height: 0.98;
	}
	.sub {
		margin-block-start: 22px;
		color: var(--muted);
		text-wrap: balance;
	}
	.portrait {
		inline-size: 380px;
		max-inline-size: 100%;
		margin-block-start: 54px;
	}
	.portrait :global(.art) {
		border-radius: 2px;
	}
	.txt {
		max-inline-size: 440px;
		/* Live text slot: at least 144px (six lines), then 26px to the hairline. */
		min-block-size: 144px;
		margin-block: 54px 0;
		font-size: 15px;
		line-height: 24px;
		letter-spacing: 0;
		color: var(--muted);
	}
	.foot {
		inline-size: 100%;
		max-inline-size: 440px;
		margin-block-start: 26px;
		padding-block-start: 19px;
		border-block-start: 1px solid var(--rule);
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.ll {
		color: var(--muted);
	}
	.list {
		margin-block-start: 12px;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 18px;
		line-height: 1.2;
		letter-spacing: 0;
	}
	.cta {
		display: inline-block;
		margin-block-start: 26px;
		padding: 19px 43px; /* + 1px border = live 20px 44px */
		border: 1px solid currentColor;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 26px;
		line-height: 1.2;
		letter-spacing: normal;
		transition: background-color 400ms var(--ease-out);
	}
	.cta:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}
	.cta:hover {
		background: var(--cta-hover);
	}
	@media (max-width: 1399.98px) {
		.portrait {
			inline-size: 320px;
		}
		.txt,
		.foot {
			max-inline-size: none;
		}
		.body {
			padding-inline: 22px;
		}
		/* Live keeps both names in a two line slot, so the halves stay level
		   when "Boky Hackel" wraps. */
		.name {
			min-block-size: 1.96em;
		}
	}
	@media (max-width: 809.98px) {
		.portrait {
			inline-size: 326px;
		}
		.body {
			padding: 50px 32px;
		}
		.name {
			min-block-size: 0;
		}
		/* Live phone: the Boky half sits 34px under its bar and ends 100px below the CTA. */
		.half--ink .body {
			padding-block: 34px 100px;
		}
		.cta {
			padding: 17px 25px;
			font-size: 21px;
		}
	}
</style>
