---
// Home section bar: 136px full-width link with a Switzer label, an arrow that
// turns from 90deg to 0deg on hover, and an underline that grows to the label width.
// Below 1400px there is no hover, so the bar shows its settled state (as live).
import { url } from "../../lib/site";
interface Props {
	href: string;
	label: string;
	/** "ne": the arrow reads ↘ at rest and ↗ on hover. "up": → at rest and ↑ on hover. */
	glyph?: "ne" | "up";
	bg: string;
	fg: string;
	hoverBg: string;
	line?: string;
	class?: string;
}
const { href, label, glyph = "ne", bg, fg, hoverBg, line = "currentColor", class: cls = "" } = Astro.props;
---

<a class:list={["bar", cls]} href={url(href)} style={`--bar-bg:${bg};--bar-fg:${fg};--bar-hover:${hoverBg};--bar-line:${line}`}>
	<span class="in">
		<span class="lbl">{label}</span>
		<svg class="ico" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
			{glyph === "ne" ? <path d="M7 17 17 7M8 7h9v9" /> : <path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" />}
		</svg>
		<span class="ul" aria-hidden="true"></span>
	</span>
</a>

<style>
	.bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		block-size: 136px;
		padding: 50px 20px;
		background: var(--bar-bg);
		color: var(--bar-fg);
		transition: background-color 500ms var(--ease-spring);
	}
	.in {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding-block-end: 8px;
		margin-block-start: 8px;
	}
	.lbl {
		font-family: var(--font-num);
		font-weight: 300;
		font-size: 22px;
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.ico {
		inline-size: 24px;
		block-size: 24px;
		transform: rotate(90deg);
		transition: transform 600ms var(--ease-spring);
	}
	.ul {
		position: absolute;
		inset-inline-start: 0;
		inset-block-end: 0;
		inline-size: 100%;
		block-size: 1px;
		background: var(--bar-line);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 600ms var(--ease-spring);
	}
	@media (hover: hover) and (min-width: 1400px) {
		.bar:hover {
			background: var(--bar-hover);
		}
		.bar:hover .ico {
			transform: rotate(0deg);
		}
		.bar:hover .ul {
			transform: scaleX(1);
		}
	}
	@media (max-width: 1399.98px) {
		.bar {
			block-size: 141px;
		}
		.lbl {
			font-size: 18px;
		}
		.ico {
			transform: rotate(0deg);
			inline-size: 20px;
			block-size: 20px;
		}
		.ul {
			transform: scaleX(1);
		}
		.bar:active {
			background: var(--bar-hover);
		}
	}
</style>
