---
// Home articles: sticky stone section with the "All Articles" bar and the
// first four news cards (two below 1400px, as live). Images keep the live
// square frame but are contained on stone, so no press photo or headline is cut.
// Sticky (curtain) only on desktop, as live.
import Card from "../Card.astro";
import SectionBar from "./SectionBar.astro";

interface Article {
	slug: string;
	title: string;
	date: string;
	image?: string;
	alt?: string;
}
interface Props {
	items: Article[];
}
const { items } = Astro.props;
---

<section class="articles" data-sticky>
	<SectionBar href="/news" label="All Articles" bg="var(--stone)" fg="var(--hairline)" hoverBg="var(--taupe)" line="var(--grey-c2)" />
	<div class="row">
		{
			items.map((a) => (
				<div class="slot">
					<Card href={`/news/${a.slug}`} image={a.image} title={a.title} date={a.date} ratio="1 / 1" bg="var(--stone)" sizes="(min-width: 1400px) 335px, (min-width: 810px) 50vw, 100vw" />
				</div>
			))
		}
	</div>
</section>

<style>
	.articles {
		position: relative;
		background: var(--stone);
		padding-block-end: 50px;
	}
	.row {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding-inline: 50px;
	}
	.slot {
		min-inline-size: 0;
	}
	/* Live text block is a fixed 350px (12px inset), so titles wrap the same
	   at every width. */
	.slot :global(.card .meta) {
		inline-size: 350px;
		max-inline-size: 100vw;
		padding: 10px 12px 32px;
	}
	/* Live home cards: the hairline sits under the text, not the image. It is
	   shown at rest below 1400px and slides in from the left on desktop hover. */
	.slot :global(.card .rule) {
		order: 3;
		margin-block-start: -1px;
		opacity: 1;
		transform: none;
	}
	@media (min-width: 1400px) {
		.slot :global(.card .rule) {
			transform: scaleX(0);
		}
		.slot :global(.card:hover .rule),
		.slot :global(.card:focus-visible .rule) {
			transform: scaleX(1);
		}
	}
	@media (min-width: 1400px) {
		.articles {
			position: sticky;
			top: 0;
		}
	}
	@media (max-width: 1399.98px) {
		.row {
			grid-template-columns: repeat(2, 1fr);
			padding-inline: 40px;
		}
		.slot:nth-child(n + 3) {
			display: none;
		}
		/* Live tablet and phone: 144px text block, date 21px (24px phone) under the image. */
		.slot :global(.card .meta) {
			min-block-size: 144px;
			padding-block-start: 21px;
		}
	}
	@media (max-width: 809.98px) {
		.row {
			grid-template-columns: 1fr;
			padding-inline: 0;
		}
		.slot :global(.card .meta) {
			padding-block-start: 24px;
		}
	}
</style>
