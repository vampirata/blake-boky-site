---
// Footer, measured on the live site at 1440, 810 and 390.
// Desktop: three link columns left, wordmark top right, Contact bottom right.
// Tablet and phone: columns, then Contact, then the wordmark fitted to the width.
import { footer, url } from "../lib/site";
const year = new Date().getFullYear();
const cols = [
	{ label: "[Links]", items: footer.links },
	{ label: "[Blake Social]", items: footer.blake },
	{ label: "[Boky Social]", items: footer.boky },
];
---

<footer class="footer">
	<div class="up">
		<div class="cols">
			{
				cols.map((c) => (
					<div class="col">
						<p class="eyebrow lab">{c.label}</p>
						<ul>
							{c.items.map((i) => {
								const ext = i.href.startsWith("http");
								return (
									<li>
										<a class="flink" href={url(i.href)} {...(ext ? { target: "_blank", rel: "noopener" } : {})}>
											{i.label}
											<span class="line" aria-hidden="true" />
										</a>
									</li>
								);
							})}
						</ul>
					</div>
				))
			}
		</div>
		<a class="contact" href={url("/contact")}>
			<span>Contact</span>
			<svg viewBox="0 0 256 256" width="20" height="20" aria-hidden="true">
				<path
					fill="currentColor"
					d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"
				></path>
			</svg>
			<span class="line" aria-hidden="true"></span>
		</a>
		<p class="word">Blake &amp; Boky</p>
	</div>
	<div class="tile">
		<p>Copyright © {year} Blake&amp;Boky. All rights reserved.</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--black);
		color: var(--white);
		padding: 52px 46px;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}
	/* Desktop: columns span both rows; wordmark top right, Contact bottom right. */
	.up {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto 1fr;
		grid-template-areas:
			"cols word"
			"cols contact";
	}
	.cols {
		grid-area: cols;
		display: grid;
		grid-template-columns: repeat(3, 216px);
		align-items: start;
		gap: 10px;
	}
	.col {
		padding: 4px;
	}
	.lab {
		padding-inline: 8px;
		color: var(--gold-light);
	}
	.col ul {
		margin-block-start: 10px;
	}
	.col:first-child ul {
		margin-block-start: 14px;
	}
	.flink,
	.contact {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 8px;
		transition: color 200ms var(--ease-link);
	}
	.flink {
		font-size: 16px;
		line-height: 25.6px;
		letter-spacing: -0.02em;
	}
	/* 1px underline 3px below the text box, from width 0 and opacity 0. */
	.line {
		position: absolute;
		left: 8px;
		top: calc(100% - 4.6px);
		block-size: 1px;
		inline-size: 0;
		opacity: 0;
		background: currentColor;
		transition:
			inline-size 200ms var(--ease-link),
			opacity 200ms var(--ease-link);
	}
	.flink:hover,
	.flink:focus-visible,
	.contact:hover,
	.contact:focus-visible {
		color: var(--gold-light);
	}
	.flink:hover .line,
	.flink:focus-visible .line,
	.contact:hover .line,
	.contact:focus-visible .line {
		inline-size: calc(100% - 16px);
		opacity: 1;
	}
	.contact {
		grid-area: contact;
		justify-self: end;
		align-self: end;
		gap: 8px;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 28px;
		line-height: 33.6px;
		letter-spacing: -0.04em;
	}
	.contact .line {
		top: calc(100% - 5px);
	}
	.word {
		grid-area: word;
		justify-self: end;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 54px;
		line-height: 59.4px;
		letter-spacing: 0.5px;
		white-space: nowrap;
	}
	.tile {
		border-block-start: 1px solid var(--gold-light);
		padding-block-start: 24px;
		font-family: var(--font-display);
		font-weight: 300;
		font-size: 13px;
		line-height: 1.6;
		letter-spacing: -0.02em;
		color: var(--grey-c2);
	}

	/* Tablet: stacked; the wordmark is fitted to the content width (live: SVG text, viewBox 354x64). */
	@media (max-width: 1399.98px) {
		.up {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
		}
		.cols {
			grid-template-columns: repeat(3, 1fr);
			inline-size: 100%;
		}
		.contact {
			align-self: flex-start;
			margin-block-start: 10px;
		}
		.word {
			align-self: stretch;
			/* Live SVG text sits at the top of its 354x64 box. */
			margin-block-start: 10px;
			padding-block-end: 0.28em;
			text-align: center;
			font-size: calc((100vw - 92px) * 44 / 354);
			line-height: 1.23;
		}
		.tile {
			font-size: 12px;
		}
	}

	@media (max-width: 809.98px) {
		.footer {
			padding: 24px 12px 52px;
		}
		.cols {
			grid-template-columns: 1fr;
		}
		.contact {
			margin-block-start: 52px;
		}
		.word {
			margin-block-start: 10px;
			padding-block-end: 0.71em;
			font-size: calc((100vw - 24px) * 34 / 360);
		}
	}
</style>
