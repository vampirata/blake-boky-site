---
// Previous / next article cards at the foot of a news article.
import Img from "../Img.astro";
import { img } from "../../lib/img";
import { url } from "../../lib/site";

interface Link {
	title: string;
	href: string;
	thumb?: { src?: string | null; alt?: string } | null;
}
interface Props {
	previous?: Link | null;
	next?: Link | null;
}
const { previous, next } = Astro.props;
const THUMB = 122 / 150;
// Cover only when the thumb frame barely differs from the photo; otherwise
// contain it so the whole image stays visible.
const fitFor = (src?: string | null) => {
	const r = img(src)?.ratio;
	if (!r) return "cover";
	return Math.abs(r - THUMB) / THUMB < 0.12 ? "cover" : "contain";
};
const items = [
	previous && { ...previous, kind: "Previous" },
	next && { ...next, kind: "Next" },
].filter(Boolean) as (Link & { kind: string })[];
---

{
	items.length > 0 && (
		<nav class="pn" aria-label="More news">
			{items.map((l) => (
				<a class:list={["c", l.kind === "Next" && "c--next"]} href={url(l.href)} data-reveal>
					{l.thumb?.src && (
						<Img src={l.thumb.src} alt={l.thumb.alt ?? ""} ratio="122 / 150" fit={fitFor(l.thumb.src)} bg="var(--n-fill, var(--paper-4))" sizes="122px" class="th" />
					)}
					<span class="tx">
						<span class="k">{l.kind}</span>
						<span class="t">{l.title.trim()}</span>
					</span>
				</a>
			))}
		</nav>
	)
}

<style>
	/* Live: 470x150 cards (half the row each below 1400, stacked 9px apart on
	   phone), a 1px #363636 border drawn inside, the thumb flush to the edge,
	   label + title centred vertically 22px from the thumb. */
	.pn {
		display: flex;
		justify-content: space-between;
		padding: 50px 32px 100px;
	}
	.c {
		position: relative;
		display: flex;
		align-items: center;
		gap: 22px;
		inline-size: 470px;
		block-size: 150px;
		/* Mode colours come from the page (--n-*), paper by default. */
		color: var(--n-text, var(--charcoal));
		transition: background-color 300ms var(--ease-out);
	}
	.c::after {
		content: "";
		position: absolute;
		inset: 0;
		border: 1px solid var(--n-line, var(--grey-363));
		pointer-events: none;
	}
	.c:hover {
		background: var(--n-hover, var(--paper-4));
	}
	.c--next {
		flex-direction: row-reverse;
		margin-inline-start: auto;
		text-align: end;
	}
	.c :global(.th) {
		flex: 0 0 122px;
		inline-size: 122px;
	}
	.tx {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-inline-size: 0;
	}
	.c:not(.c--next) .tx {
		padding-inline-end: 22px;
	}
	.c--next .tx {
		padding-inline-start: 22px;
	}
	.k {
		font-weight: 400;
		font-size: 12px;
		line-height: 19.2px;
		letter-spacing: 1.8px;
		text-transform: uppercase;
	}
	.t {
		font-size: 16px;
		line-height: 25.6px;
		letter-spacing: -0.32px;
	}
	@media (max-width: 1399.98px) {
		.c {
			flex: 1 1 0;
			inline-size: auto;
		}
	}
	@media (max-width: 809.98px) {
		.pn {
			flex-direction: column;
			gap: 9px;
			padding-inline: 15px;
		}
		.c {
			flex: none;
			inline-size: 100%;
		}
	}
</style>
