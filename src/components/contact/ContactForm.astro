---
// Contact message form. Native validation and inline success and error states.
// With a Web3Forms key (formKey) it posts to Web3Forms, which emails the
// address the key was created for. Without a key it opens the visitor's email
// app with the message prefilled to the artists' addresses.
/* eslint-disable @typescript-eslint/no-explicit-any */
const ENDPOINT = "https://api.web3forms.com/submit";
interface Props {
	formKey?: string;
	fields: any[];
	options: any[];
	submitLabel?: string;
	fallbackEmails: string[];
}
const { formKey = "", fields, options, submitLabel = "Send message", fallbackEmails } = Astro.props;
const f = (name: string) => fields.find((x) => x.name === name) ?? {};
const label = (name: string) => String(f(name).label ?? name).split("\n")[0].trim();

// Group the select options under their dividers (optgroups).
type Opt = { value: string; label: string };
const lead: Opt[] = [];
const groups: { label: string; options: Opt[] }[] = [];
for (const o of options) {
	if (o.divider) groups.push({ label: o.divider, options: [] });
	else if (groups.length) groups[groups.length - 1].options.push(o);
	else lead.push(o);
}
---

<form
	class="cform"
	action={formKey ? ENDPOINT : `mailto:${fallbackEmails.join(",")}`}
	method="post"
	enctype={formKey ? undefined : "text/plain"}
	data-contact-form
	data-endpoint={formKey ? ENDPOINT : ""}
	data-to={fallbackEmails.join(",")}
>
	{formKey && <input type="hidden" name="access_key" value={formKey} />}
	{formKey && <input type="hidden" name="subject" value="New inquiry from blakeandboky.com" />}
	{formKey && <input type="hidden" name="from_name" value="Blake & Boky website" />}
	<div class="field">
		<label class="eyebrow lab" for="cf-name">{label("name")}</label>
		<input id="cf-name" name="name" type="text" placeholder={f("name").placeholder} required autocomplete="name" />
	</div>
	<div class="field">
		<label class="eyebrow lab" for="cf-email">{label("email")}</label>
		<input id="cf-email" name="email" type="email" placeholder={f("email").placeholder} required autocomplete="email" />
	</div>
	<div class="field">
		<label class="eyebrow lab" for="cf-piece">{label("piece_interested_in")}</label>
		<div class="sel">
			<select id="cf-piece" name="piece_interested_in">
				{lead.map((o) => <option value={o.value}>{o.label}</option>)}
				{
					groups.map((g) => (
						<optgroup label={g.label}>
							{g.options.map((o) => (
								<option value={o.value}>{o.label}</option>
							))}
						</optgroup>
					))
				}
			</select>
			<svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1" /></svg>
		</div>
	</div>
	<div class="field">
		<label class="eyebrow lab" for="cf-message">{label("message")}</label>
		<textarea id="cf-message" name="message" rows="4" placeholder={f("message").placeholder} required></textarea>
	</div>

	<!-- Honeypot: hidden from people, bots fill it in. -->
	<div class="hp" aria-hidden="true">
		<label for="cf-website">Website</label>
		<input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<button class="send" type="submit">{submitLabel}</button>

	<p class="status" role="status" aria-live="polite" data-status hidden></p>
	<p class="status" data-kind="error" data-error role="alert" hidden>
		Sorry, your message could not be sent. Please write to us directly at {fallbackEmails.map((addr, i) => <>{i > 0 && " or "}<a href={`mailto:${addr}`}>{addr}</a></>)}.
	</p>
</form>

<script>
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]")!;
		const err = form.querySelector<HTMLElement>("[data-error]")!;
		const btn = form.querySelector<HTMLButtonElement>(".send")!;
		const label = btn.textContent;
		const show = (kind: "ok" | "error", text = "") => {
			status.hidden = kind !== "ok";
			err.hidden = kind !== "error";
			status.textContent = text;
		};
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			if (!form.reportValidity()) return;
			const data = new FormData(form);
			// Honeypot filled: pretend success, send nothing.
			if (String(data.get("website") ?? "").trim()) {
				form.reset();
				show("ok", "Thank you. Your message has been sent, we will be in touch soon.");
				return;
			}
			data.delete("website");
			const endpoint = form.dataset.endpoint;
			if (!endpoint) {
				// No delivery key yet: hand the message to the visitor's email app.
				const name = String(data.get("name") ?? "");
				const piece = String(data.get("piece_interested_in") ?? "");
				const body = [String(data.get("message") ?? ""), "", `Name: ${name}`, `Email: ${data.get("email") ?? ""}`, piece ? `Piece: ${piece}` : ""].filter((l, i) => i < 2 || l).join("\n");
				const href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(`Inquiry from ${name}`)}&body=${encodeURIComponent(body)}`;
				window.location.href = href;
				show("ok", "Your email app should open with the message ready to send.");
				return;
			}
			btn.disabled = true;
			btn.textContent = "Sending…";
			status.hidden = true;
			err.hidden = true;
			try {
				const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
				const json = await res.json().catch(() => ({}));
				if (!res.ok || json.success === false) throw new Error(String(res.status));
				form.reset();
				show("ok", "Thank you. Your message has been sent, we will be in touch soon.");
			} catch {
				show("error");
			} finally {
				btn.disabled = false;
				btn.textContent = label;
			}
		});
	});
</script>

<style>
	/* Grey mode (the contact page sits on stone): light fields, gold focus. */
	.cform {
		display: flex;
		flex-direction: column;
		gap: 28px;
		inline-size: 100%;
		max-inline-size: 680px;
		margin-inline: auto;
		text-align: start;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 11px;
	}
	.lab {
		color: var(--stone-text);
	}
	input,
	textarea,
	select {
		inline-size: 100%;
		font-family: var(--font-display);
		font-size: 20px;
		font-weight: 400;
		line-height: 24px;
		letter-spacing: 0;
		color: var(--paper);
		background: transparent;
		border: 0;
		border-radius: 0;
		outline: none;
	}
	input,
	textarea {
		/* Live: 24px text line with 10px above and below, hairline under. */
		padding: 10px 0;
		border-block-end: 1px solid var(--stone-muted);
		transition:
			border-color 200ms var(--ease-link),
			box-shadow 200ms var(--ease-link);
	}
	textarea {
		block-size: 120px;
		resize: vertical;
	}
	input:focus,
	textarea:focus {
		border-color: var(--gold-light);
		box-shadow: 0 1px 0 var(--gold-light);
	}
	::placeholder {
		color: var(--stone-muted);
		opacity: 0.85;
	}
	.sel {
		position: relative;
		color: var(--paper);
	}
	select {
		appearance: none;
		-webkit-appearance: none;
		block-size: 44px;
		padding: 0 40px 0 16px;
		background: var(--stone-deep);
		border-radius: 8px;
		border: 1px solid var(--stone-rule);
		cursor: pointer;
	}
	/* The open list is drawn by the system: keep it dark text on paper. */
	select option,
	select optgroup {
		color: var(--charcoal);
		background: var(--paper);
	}
	select:focus-visible {
		outline: 1px solid var(--gold-light);
		outline-offset: 2px;
	}
	.chev {
		position: absolute;
		inset-inline-end: 16px;
		inset-block-start: 50%;
		inline-size: 12px;
		block-size: 12px;
		translate: 0 -50%;
		pointer-events: none;
		color: var(--stone-text);
	}
	.hp {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		left: -9999px;
	}
	.send {
		align-self: center;
		margin-block-start: 12px;
		padding: 14px 39px;
		border: 1px solid var(--paper);
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 14px;
		line-height: 16.8px;
		letter-spacing: 1.92px;
		text-transform: uppercase;
		color: var(--paper);
		transition:
			background-color 300ms var(--ease-out),
			color 300ms var(--ease-out),
			border-color 300ms var(--ease-out);
	}
	.send:hover {
		background: var(--gold);
		border-color: var(--gold);
		color: var(--ink);
	}
	.send:focus-visible {
		outline: 1px solid var(--gold-light);
		outline-offset: 3px;
	}
	.send:disabled {
		opacity: 0.6;
		cursor: progress;
	}
	.status {
		text-align: center;
		color: var(--paper);
	}
	.status[data-kind="error"] {
		color: #ffc4b8;
	}
	.status :global(a) {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
