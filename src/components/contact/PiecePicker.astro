---
// "Pieces interested in": every published work from the CMS (collections.json +
// works.json), grouped by collection, multi-select with search. Optional: no
// selection means a general inquiry. /contact?piece=<work-slug> preselects a
// work (used by "Inquire about this piece" on each artwork page).
// Submits one field, piece_interested_in, as "Title (Collection); ...".
import { collections, worksIn } from "../../lib/data";

interface Props {
	label: string;
	name?: string;
}
const { label, name = "piece_interested_in" } = Astro.props;
const groups = collections
	.filter((c) => !c.comingSoon)
	.map((c) => ({
		slug: c.slug,
		title: c.title.trim(),
		works: worksIn(c.slug).map((w) => ({ slug: w.slug, title: w.title.trim() })),
	}))
	.filter((g) => g.works.length);
const total = groups.reduce((n, g) => n + g.works.length, 0);
---

<div class="pp" data-pp>
	<span class="eyebrow lab" id="pp-label">{label}</span>
	<button type="button" class="pp-trigger" aria-expanded="false" aria-controls="pp-panel" aria-labelledby="pp-label pp-summary" data-pp-trigger>
		<span id="pp-summary" data-pp-summary>General inquiry, or choose pieces</span>
		<svg class="pp-chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1"></path></svg>
	</button>
	<ul class="pp-chips" data-pp-chips aria-label="Selected pieces"></ul>
	<div class="pp-panel" id="pp-panel" data-pp-panel hidden>
		<input class="pp-search" type="search" placeholder={`Search ${total} pieces`} aria-label="Search pieces" data-pp-search autocomplete="off" />
		<div class="pp-groups" data-pp-groups>
			{
				groups.map((g) => (
					<fieldset class="pp-group" data-pp-group>
						<legend class="micro">{g.title}</legend>
						{g.works.map((w) => (
							<label class="pp-opt" data-pp-opt data-title={w.title.toLowerCase()}>
								<input type="checkbox" value={`${w.title} (${g.title})`} data-slug={w.slug} data-title={w.title} />
								<span>{w.title}</span>
							</label>
						))}
					</fieldset>
				))
			}
			<p class="pp-none" data-pp-none hidden>No pieces match your search.</p>
		</div>
		<div class="pp-foot">
			<button type="button" class="pp-clear" data-pp-clear>Clear</button>
			<button type="button" class="pp-done" data-pp-done>Done</button>
		</div>
	</div>
	<input type="hidden" name={name} value="" data-pp-value />
</div>

<script>
	document.querySelectorAll<HTMLElement>("[data-pp]").forEach((root) => {
		const trigger = root.querySelector<HTMLButtonElement>("[data-pp-trigger]")!;
		const panel = root.querySelector<HTMLElement>("[data-pp-panel]")!;
		const summary = root.querySelector<HTMLElement>("[data-pp-summary]")!;
		const chips = root.querySelector<HTMLElement>("[data-pp-chips]")!;
		const value = root.querySelector<HTMLInputElement>("[data-pp-value]")!;
		const search = root.querySelector<HTMLInputElement>("[data-pp-search]")!;
		const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
		const none = root.querySelector<HTMLElement>("[data-pp-none]")!;

		const sync = () => {
			const on = boxes.filter((b) => b.checked);
			value.value = on.map((b) => b.value).join("; ");
			summary.textContent = on.length === 0 ? "General inquiry, or choose pieces" : on.length === 1 ? on[0].dataset.title! : `${on.length} pieces selected`;
			chips.innerHTML = "";
			on.forEach((b) => {
				const li = document.createElement("li");
				const t = document.createElement("span");
				t.textContent = b.dataset.title!;
				const x = document.createElement("button");
				x.type = "button";
				x.setAttribute("aria-label", `Remove ${b.dataset.title}`);
				x.textContent = "×";
				x.addEventListener("click", () => { b.checked = false; sync(); });
				li.append(t, x);
				chips.appendChild(li);
			});
		};
		const open = (state: boolean) => {
			panel.hidden = !state;
			trigger.setAttribute("aria-expanded", String(state));
			root.classList.toggle("is-open", state);
			if (state) setTimeout(() => search.focus(), 30);
		};
		trigger.addEventListener("click", () => open(panel.hidden));
		root.querySelector("[data-pp-done]")!.addEventListener("click", () => { open(false); trigger.focus(); });
		root.querySelector("[data-pp-clear]")!.addEventListener("click", () => { boxes.forEach((b) => (b.checked = false)); sync(); });
		boxes.forEach((b) => b.addEventListener("change", sync));
		search.addEventListener("input", () => {
			const q = search.value.trim().toLowerCase();
			let shown = 0;
			root.querySelectorAll<HTMLElement>("[data-pp-group]").forEach((g) => {
				let any = false;
				g.querySelectorAll<HTMLElement>("[data-pp-opt]").forEach((o) => {
					const hit = !q || o.dataset.title!.includes(q) || (g.querySelector("legend")?.textContent ?? "").toLowerCase().includes(q);
					o.hidden = !hit;
					if (hit) { any = true; shown++; }
				});
				g.hidden = !any;
			});
			none.hidden = shown > 0;
		});
		root.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !panel.hidden) { e.stopPropagation(); open(false); trigger.focus(); }
		});
		document.addEventListener("click", (e) => { if (!panel.hidden && !root.contains(e.target as Node)) open(false); });
		root.closest("form")?.addEventListener("reset", () => setTimeout(() => { boxes.forEach((b) => (b.checked = false)); sync(); }));

		// Preselect from ?piece=<slug> (one or several, comma separated).
		const want = (new URLSearchParams(location.search).get("piece") ?? "").split(",").filter(Boolean);
		boxes.forEach((b) => { if (want.includes(b.dataset.slug!)) b.checked = true; });
		sync();
	});
</script>

<style>
	.pp {
		display: grid;
		gap: 10px;
		position: relative;
	}
	.pp-trigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		inline-size: 100%;
		padding: 10px 2px 12px;
		border-block-end: 1px solid var(--hairline);
		font-family: var(--font-display);
		font-size: 24px;
		line-height: 1.3;
		text-align: start;
		color: var(--charcoal);
		transition: border-color 200ms var(--ease-link);
	}
	.pp-trigger:hover,
	.is-open .pp-trigger {
		border-block-end-color: var(--charcoal);
	}
	.pp-chev {
		inline-size: 14px;
		block-size: 14px;
		flex: none;
		transition: transform 300ms var(--ease-out);
	}
	.is-open .pp-chev {
		transform: rotate(180deg);
	}
	.pp-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.pp-chips:empty {
		display: none;
	}
	.pp-chips :global(li) {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 6px 5px 12px;
		border: 1px solid var(--hairline);
		font-size: 14px;
		color: var(--charcoal);
	}
	.pp-chips :global(button) {
		inline-size: 22px;
		block-size: 22px;
		display: grid;
		place-items: center;
		font-size: 16px;
		line-height: 1;
		color: var(--taupe);
	}
	.pp-chips :global(button:hover) {
		color: var(--ink);
	}
	.pp-panel {
		border: 1px solid var(--hairline);
		background: var(--white);
		padding: 16px;
		display: grid;
		gap: 12px;
	}
	.pp-panel[hidden],
	.pp-none[hidden] {
		display: none;
	}
	.pp-search {
		inline-size: 100%;
		padding: 10px 12px;
		border: 1px solid var(--hairline);
		background: transparent;
		font: inherit;
		font-size: 16px;
		color: var(--charcoal);
	}
	.pp-search:focus {
		outline: none;
		border-color: var(--charcoal);
	}
	.pp-groups {
		max-block-size: 320px;
		overflow-y: auto;
		overscroll-behavior: contain;
		display: grid;
		gap: 16px;
		padding-inline-end: 4px;
	}
	.pp-group {
		border: 0;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2px 16px;
	}
	.pp-group legend {
		padding: 0 0 6px;
		color: var(--taupe);
	}
	.pp-opt {
		display: flex;
		align-items: center;
		gap: 10px;
		min-block-size: 36px;
		font-size: 16px;
		color: var(--charcoal);
		cursor: pointer;
	}
	.pp-opt[hidden],
	.pp-group[hidden] {
		display: none;
	}
	.pp-opt input {
		inline-size: 16px;
		block-size: 16px;
		accent-color: var(--ink);
		flex: none;
	}
	.pp-none {
		color: var(--taupe);
		font-size: 14px;
	}
	.pp-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-block-start: 8px;
		border-block-start: 1px solid var(--hairline);
	}
	.pp-clear,
	.pp-done {
		font-size: 12px;
		letter-spacing: 1.92px;
		text-transform: uppercase;
		padding: 10px 14px;
	}
	.pp-clear {
		color: var(--taupe);
	}
	.pp-done {
		background: var(--ink);
		color: var(--white);
		transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out);
	}
	.pp-done:hover {
		background: var(--gold);
		color: var(--ink);
	}
	@media (max-width: 809.98px) {
		.pp-group {
			grid-template-columns: minmax(0, 1fr);
		}
		.pp-trigger {
			font-size: 20px;
		}
	}
</style>
