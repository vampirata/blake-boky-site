---
import { url } from "../lib/site";
interface Props {
	href: string;
	label: string;
	tone?: "dark" | "light";
}
const { href, label, tone = "dark" } = Astro.props;
---

<a class:list={["pill", `pill--${tone}`]} href={url(href)}>
	<span class="arr" aria-hidden="true">←</span>
	<span>{label}</span>
</a>

<style>
	.pill {
		position: fixed;
		top: 88px;
		left: 20px;
		z-index: 40;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		block-size: 38px;
		padding: 10px 18px 10px 14px;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 12px;
		line-height: 1.2;
		letter-spacing: 0.96px;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition:
			background-color 300ms var(--ease-out),
			color 300ms var(--ease-out);
	}
	.arr {
		font-size: 15px;
	}
	.pill--dark {
		background: var(--ink-55);
		color: #f2f2f2;
	}
	.pill--dark .arr {
		color: var(--gold-light);
	}
	.pill--light {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(15, 15, 15, 0.15);
		color: var(--ink);
	}
	.pill:hover {
		background: var(--gold);
		color: var(--ink);
	}
	.pill:hover .arr {
		color: var(--ink);
	}
	@media (max-width: 1399.98px) {
		.pill {
			top: 76px;
			left: 8px;
		}
	}
</style>
