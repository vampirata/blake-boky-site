---
import { url } from "../lib/site";
interface Props {
	href: string;
	label: string;
	tone?: "dark" | "light";
}
const { href, label, tone = "dark" } = Astro.props;
---

<a class:list={["pill", `pill--${tone}`]} href={url(href)}>
	<span class="arr" aria-hidden="true">←</span>
	<span>{label}</span>
</a>

<style>
	/* Live: fixed at top 88px (all widths), left 20px desktop / 8px below 1400.
	   The 1px border is drawn inside the box (Framer ::after), so it adds no size. */
	.pill {
		position: fixed;
		top: 88px;
		left: 20px;
		z-index: 40;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		block-size: 38px;
		padding: 10px 18px 10px 14px;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 12px;
		line-height: 1.2;
		letter-spacing: 0.96px;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition: background-color 200ms var(--ease-link);
	}
	.pill::after {
		content: "";
		position: absolute;
		inset: 0;
		border: 1px solid var(--taupe);
		pointer-events: none;
		transition: border-color 200ms var(--ease-link);
	}
	.arr {
		font-size: 15px;
		line-height: 18px;
		letter-spacing: normal;
	}
	.pill--dark {
		background: var(--ink-55);
		color: #f2f2f2;
	}
	.pill--dark .arr {
		color: var(--gold-light);
	}
	.pill--light {
		background: rgba(255, 255, 255, 0.02);
		color: var(--ink);
	}
	/* Hover: the fill turns gold (dark) or light gold (light), the border fades out, text keeps its colours. */
	.pill--dark:hover {
		background: var(--gold);
	}
	.pill--light:hover {
		background: var(--gold-light);
	}
	.pill:hover::after {
		border-color: transparent;
	}
	@media (max-width: 1399.98px) {
		.pill {
			left: 8px;
		}
	}
</style>
