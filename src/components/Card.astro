---
// Grid card used on collections, news, past works, galleries and bios:
// image frame, then date (Switzer) and a per-character title.
// Motion: the image wipes in (motion.ts), the caption fades up after it; on
// hover the image breathes in and the caption drifts a few pixels right.
import Img from "./Img.astro";
import SplitTitle from "./SplitTitle.astro";
import { url } from "../lib/site";
interface Props {
	href: string;
	image?: string;
	title: string;
	date?: string;
	ratio?: string;
	ratioTablet?: string;
	ratioPhone?: string;
	bg?: string;
	sizes?: string;
	tone?: "dark" | "light";
	external?: boolean;
}
const { href, image, title, date, ratio = "4 / 5", ratioTablet, ratioPhone, bg = "transparent", sizes = "(min-width: 1400px) 25vw, (min-width: 810px) 50vw, 100vw", tone = "dark", external = false } = Astro.props;
---

<a class:list={["card", `card--${tone}`]} href={url(href)} {...(external ? { target: "_blank", rel: "noopener" } : {})}>
	{image && <Img src={image} ratio={ratio} ratioTablet={ratioTablet} ratioPhone={ratioPhone} bg={bg} zoom sizes={sizes} />}
	<div class="meta" data-reveal>
		{date && <p class="card-date d">{date}</p>}
		<SplitTitle text={title} class="card-title" />
	</div>
	<span class="rule" aria-hidden="true"></span>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		min-inline-size: 0;
	}
	/* Hairline under the title: hidden on desktop until hover (live). */
	.rule {
		display: block;
		block-size: 1px;
		margin-block-start: 10px;
		background: currentColor;
		transition:
			transform 600ms var(--ease-spring),
			opacity 600ms var(--ease-spring);
		transform-origin: left;
	}
	@media (hover: hover) and (min-width: 1400px) {
		.rule {
			opacity: 0;
			transform: scaleX(0);
		}
		.card:hover .rule,
		.card:focus-visible .rule {
			opacity: 1;
			transform: none;
		}
	}
	.meta {
		padding: 14px 12px 0;
	}
	.meta > :global(*) {
		transition: translate 700ms var(--ease-out);
	}
	.meta > :global(.split) {
		transition-delay: 40ms;
	}
	@media (hover: hover) {
		.card:hover .meta > :global(*),
		.card:focus-visible .meta > :global(*) {
			translate: 6px 0;
		}
	}
	.card--dark {
		color: var(--white);
	}
	.card--dark .d {
		color: var(--white);
	}
	.card--light {
		color: var(--black);
	}
	.card--light .d {
		color: var(--black);
	}
</style>
