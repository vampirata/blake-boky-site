---
// Grid card used on collections, news, past works, galleries and bios:
// image frame, then date (Switzer) and a per-character title.
import Img from "./Img.astro";
import SplitTitle from "./SplitTitle.astro";
import { url } from "../lib/site";
interface Props {
	href: string;
	image?: string;
	title: string;
	date?: string;
	ratio?: string;
	bg?: string;
	sizes?: string;
	tone?: "dark" | "light";
	external?: boolean;
}
const { href, image, title, date, ratio = "4 / 5", bg = "transparent", sizes = "(min-width: 1400px) 25vw, (min-width: 810px) 50vw, 100vw", tone = "dark", external = false } = Astro.props;
---

<a class:list={["card", `card--${tone}`]} href={url(href)} data-reveal {...(external ? { target: "_blank", rel: "noopener" } : {})}>
	{image && <Img src={image} ratio={ratio} bg={bg} zoom sizes={sizes} />}
	<span class="rule" aria-hidden="true"></span>
	<div class="meta">
		{date && <p class="card-date d">{date}</p>}
		<SplitTitle text={title} class="card-title" />
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		min-inline-size: 0;
	}
	.rule {
		display: block;
		block-size: 1px;
		background: var(--hairline);
		opacity: 0.6;
		transition: transform 600ms var(--ease-spring);
		transform-origin: left;
	}
	.card:hover .rule {
		transform: scaleX(0.96);
	}
	.meta {
		padding: 14px 10px 0;
	}
	.card--dark {
		color: var(--white);
	}
	.card--dark .d {
		color: var(--white);
	}
	.card--light {
		color: var(--black);
	}
	.card--light .d {
		color: var(--taupe);
	}
</style>
