---
// Template "galleries": Petley Jones Gallery page with the Gallery Partners grid.
// Grey mode (shared page, see docs/rebuild-rules.md "Colour modes"): stone.
import Base from "../../layouts/Base.astro";
import Img from "../../components/Img.astro";
import ContactCta from "../../components/ContactCta.astro";
import PartnerCard from "../../components/galleries/PartnerCard.astro";
import { cleanTitle } from "../../lib/data";
import page from "../../content/data/pages/galleriespetley.json";
import galleriesRaw from "../../content/data/galleries.json";

/* eslint-disable @typescript-eslint/no-explicit-any */
const sections = page.sections as any[];
const sec = (name: string) => sections.find((s) => s.name === name);
const hero = sec("Hero");
const partners = sec("Gallery Partners");
const intro = sec("Introduction");
const exh = sec("Exhibitions");
const views = sec("Installation Views");
const visit = sec("Visit");

const galleries = [...(galleriesRaw as any[])].sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

// Exhibition blocks: Year, Title, Description triples in body order, one banner each.
const blocks: { year: string; title: string; text: string; image: any }[] = [];
for (const b of exh.body as any[]) {
	if (b.role === "Year") blocks.push({ year: b.text, title: "", text: "", image: exh.media[blocks.length] });
	else if (b.role === "Title") blocks[blocks.length - 1].title = b.text;
	else if (b.role === "Description") blocks[blocks.length - 1].text = b.text;
}
// Banners are cover crops of landscape panoramas (fine, brief). A portrait source
// (taller than wide) is shown whole instead.
const isPortrait = (m: any) => m.naturalHeight > m.naturalWidth;

const visitHtml = (visit.content.find((c: any) => c.role === "Details")?.html ?? "").replace(/<!--\/?\$-->/g, "");
const title = cleanTitle(page.seo.title, "Petley Jones Gallery");
---

<Base title={title} description={page.seo.description} ogImage={blocks[0]?.image?.src} nav="black" bg="var(--stone)" fg="var(--stone-text)">
	<section class="hero">
		<p class="eyebrow e">{hero.eyebrow}</p>
		<h1 class="display">{hero.heading.text}</h1>
		<p class="subtitle sub">{hero.body[0].text}</p>
		<div class="logo">
			<Img src={hero.media[0].src} alt={hero.media[0].alt} sizes="420px" eager />
		</div>
	</section>

	<section class="partners">
		<header class="head">
			<p class="eyebrow e">{partners.eyebrow}</p>
			<h2 class="h2">{partners.heading.text}</h2>
		</header>
		<div class="pgrid">
			{galleries.map((g) => <PartnerCard href={g.path} image={g.cardImage.src} alt={g.cardImage.alt} title={g.cardTitle.trim()} date={g.date} />)}
		</div>
	</section>

	<section class="intro">
		<p class="intro-italic">{intro.body[0].text}</p>
	</section>

	<section class="exh">
		<header class="head">
			<p class="eyebrow e">{exh.eyebrow}</p>
			<h2 class="h2">{exh.heading.text}</h2>
		</header>
		<div class="blocks">
			{
				blocks.map((b, i) => (
					<article class="block">
						<div class:list={["banner", `banner--${i + 1}`, isPortrait(b.image) && "banner--whole"]}>
							{isPortrait(b.image) ? (
								<Img src={b.image.src} alt={b.image.alt} bg="var(--stone)" sizes="100vw" />
							) : (
								<Img src={b.image.src} alt={b.image.alt} sizes="100vw" />
							)}
						</div>
						<div class="row">
							<div>
								<p class="eyebrow e">{b.year}</p>
								<h3 class="h2">{b.title}</h3>
							</div>
							<p class="desc">{b.text}</p>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="views">
		<header class="head">
			<p class="eyebrow e">{views.eyebrow}</p>
			<h2 class="h2">{views.heading.text}</h2>
		</header>
		<div class="vgrid">
			{
				views.media.map((m: any, i: number) => (
					<div class:list={["v", `v--${i + 1}`]}>
						<Img src={m.src} alt={m.alt} ratio="4 / 5" bg="var(--stone)" sizes="(min-width: 1400px) 432px, (min-width: 810px) 50vw, 100vw" />
					</div>
				))
			}
		</div>
	</section>

	<section class="visit">
		<p class="eyebrow e">{visit.eyebrow}</p>
		<h2 class="h2">{visit.heading.text}</h2>
		<div class="vtext" set:html={visitHtml} />
	</section>

	<ContactCta eyebrow="" tone="dark" />
</Base>

<style>
	section {
		color: var(--stone-text);
		/* Partner cards read these (grey mode). */
		--pc-text: var(--stone-text);
		--pc-fill: var(--stone);
	}
	h1,
	h2,
	h3 {
		color: var(--paper);
	}
	/* Live: every section after the hero carries a 1px top rule drawn inside
	   the box (Framer ::after), the Contact CTA included. Grey mode: light hairline. */
	.partners,
	.intro,
	.exh,
	.views,
	.visit,
	:global(.ccta) {
		box-shadow: inset 0 1px 0 var(--stone-rule);
	}
	.e {
		color: var(--stone-text);
	}
	.head {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		padding-inline: var(--gutter);
		text-align: center;
	}

	/* Hero: padding 150 0 70 */
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 26px;
		padding: 150px 32px 70px;
		text-align: center;
	}
	.sub {
		color: var(--stone-muted);
	}
	/* The partner's black and red logo is unreadable on stone, so it sits on a
	   paper plate; the image multiplies onto the plate so its white box disappears. */
	.logo {
		inline-size: 420px;
		max-inline-size: 100%;
		margin-block-start: 22px;
		padding: 14px 20px;
		background: var(--paper);
		isolation: isolate;
	}
	.logo :global(img) {
		mix-blend-mode: multiply;
	}

	/* Gallery Partners: 3 x 453 squares, gap 8 */
	.partners {
		padding: 80px 0;
	}
	.pgrid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px 8px;
		padding: 56px 32px 0;
	}

	/* Introduction */
	.intro {
		padding: 80px 32px;
	}
	.intro p {
		max-inline-size: 800px;
		margin-inline: auto;
		text-align: center;
		color: var(--paper);
	}

	/* Exhibitions */
	.exh {
		padding: 80px 0;
	}
	.blocks {
		display: flex;
		flex-direction: column;
		gap: 100px;
		padding: 56px 32px 0;
	}
	/* Banners show at their own ratio: they carry heads and baked-in exhibition
	   titles that a fixed-height cover crop cut off at wide widths. */
	.banner :global(.art) {
		block-size: auto;
	}
	.banner--1 {
		--bh: 267px;
	}
	.banner--2 {
		--bh: 391px;
	}
	.banner--3 {
		--bh: 501px;
	}
	.banner--whole :global(.art) {
		block-size: auto;
		max-block-size: 80vh;
	}
	.row {
		display: grid;
		grid-template-columns: minmax(0, 611fr) minmax(0, 765fr);
		padding-block-start: 32px;
	}
	.row .eyebrow {
		margin-block-end: 8px;
	}
	.desc {
		color: var(--stone-text);
	}

	/* Installation Views: 3 x 432, gap 40 */
	.views {
		padding: 80px 0;
	}
	.vgrid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: start;
		gap: 40px;
		padding: 56px 32px 0;
	}

	/* Visit */
	.visit {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 80px 32px;
		text-align: center;
	}
	.visit .h2 {
		margin-block: 20px 26px;
	}
	.vtext {
		max-inline-size: 600px;
		color: var(--stone-text);
	}
	.vtext :global(a) {
		color: var(--paper);
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 200ms var(--ease-link);
	}
	.vtext :global(a:hover) {
		color: var(--gold-light);
	}

	/* Contact CTA has no eyebrow on this page live. */
	:global(.ccta .e:empty) {
		display: none;
	}

	@media (max-width: 1399.98px) {
		.hero {
			padding-block-end: 70px;
		}
		.logo {
			margin-block-start: 30px;
		}
		.pgrid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 8px;
			padding-block-start: 49px;
		}
		.intro p {
			max-inline-size: 640px;
		}
		.blocks {
			padding-block-start: 53px;
		}
		.banner--1 {
			--bh: 179px;
		}
		.banner--2 {
			--bh: 262px;
		}
		.banner--3 {
			--bh: 335px;
		}
		.row {
			grid-template-columns: minmax(0, 348fr) minmax(0, 398fr);
		}
		/* Live title column is 284px wide, so "The Space Within" wraps. */
		.row h3 {
			max-inline-size: 284px;
		}
		.vgrid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 8px;
			padding-block-start: 53px;
		}
		.v--1 {
			grid-column: 1;
			grid-row: 1;
		}
		.v--2 {
			grid-column: 2;
			grid-row: 1 / span 2;
		}
		.v--3 {
			grid-column: 1;
			grid-row: 2;
		}
	}

	@media (max-width: 809.98px) {
		.hero {
			padding-inline: 12px;
		}
		.logo {
			inline-size: 100%;
		}
		.pgrid {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
			padding-inline: 0;
		}
		.intro {
			padding-inline: 16px;
		}
		.blocks {
			padding-inline: 0;
		}
		.banner--1 {
			--bh: 120px;
		}
		.banner--2 {
			--bh: 150px;
		}
		.banner--3 {
			--bh: 190px;
		}
		.row {
			grid-template-columns: minmax(0, 1fr);
			gap: 20px;
			padding-inline: 12px;
		}
		.vgrid {
			grid-template-columns: minmax(0, 1fr);
			padding-inline: 0;
		}
		.v--1,
		.v--2,
		.v--3 {
			grid-column: 1;
			grid-row: auto;
		}
		.visit {
			padding-inline: 32px;
		}
	}
</style>
