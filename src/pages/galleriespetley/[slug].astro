---
// Template "gallery-detail": one gallery partner page.
import Base from "../../layouts/Base.astro";
import Img from "../../components/Img.astro";
import BackPill from "../../components/BackPill.astro";
import ContactCta from "../../components/ContactCta.astro";
import galleriesRaw from "../../content/data/galleries.json";

/* eslint-disable @typescript-eslint/no-explicit-any */
export function getStaticPaths() {
	return (galleriesRaw as any[]).map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: any };

// Body: drop empty paragraphs and unfilled placeholder text (e.g. "hhh").
const isPlaceholder = (html: string) => {
	const text = html.replace(/<[^>]+>/g, "").replace(/&nbsp;/g, " ").trim();
	return !text || /^(h+|x+|lorem.*|tbd|todo|placeholder)$/i.test(text);
};
const body = (g.content as any[]).map((c) => c.html as string).filter((h) => !isPlaceholder(h));
const hidden = (g.content as any[]).map((c) => c.html as string).filter((h) => h.replace(/<[^>]+>/g, "").trim() && isPlaceholder(h));
if (hidden.length) console.warn(`[gallery-detail] ${g.slug}: hid placeholder body text ${JSON.stringify(hidden)}`);

// "Visit gallery website" pointed back to this same page live. Use the first real
// external URL in the data; with none, hide the button.
const external = (g.externalLinks as any[]).find((l) => /^https?:\/\//.test(l.href));
if (!external) console.warn(`[gallery-detail] ${g.slug}: no external gallery website in data, "Visit gallery website" hidden`);

const hero = g.heroImage;
const ratio = hero.naturalWidth && hero.naturalHeight ? hero.naturalWidth / hero.naturalHeight : 1;
const backLabel = String(g.backLink?.label ?? "Galleries").replace(/^[←\s]+/, "");
const showInfo = body.length > 0 || !!external;
---

<Base title={g.title} description={g.seo?.description} ogImage={hero.src} nav="light" bg="var(--paper)" fg="var(--charcoal)">
	<BackPill href={g.backLink?.href ?? "/galleriespetley"} label={backLabel} tone="light" />

	<section class="hero">
		<p class="eyebrow e">{g.eyebrow}</p>
		<h1 class="display">{g.title}</h1>
	</section>

	<section class="image">
		<Img
			src={hero.src}
			alt={hero.alt || g.title}
			bg="var(--paper)"
			eager
			sizes="(min-width: 1400px) 1312px, 100vw"
			style={`inline-size:min(100%, calc(80vh * ${ratio.toFixed(4)}));margin-inline:auto`}
		/>
	</section>

	{
		showInfo && (
			<section class="info">
				{body.length > 0 && <div class="body" set:html={body.join("")} />}
				{external && (
					<a class="visit link" href={external.href} target="_blank" rel="noopener">
						Visit gallery website
					</a>
				)}
			</section>
		)
	}

	<ContactCta eyebrow="" />
</Base>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 26px;
		padding: 180px 32px 64px;
		text-align: center;
		color: var(--charcoal);
	}
	.e {
		color: var(--taupe);
	}
	.image {
		padding: 20px 64px 80px;
	}
	.image :global(.art) {
		max-block-size: 80vh;
	}
	.info {
		display: flex;
		flex-direction: column;
		gap: 32px;
		padding: 80px 32px;
		border-block: 1px solid var(--hairline);
	}
	.body {
		color: var(--taupe-2);
	}
	.body :global(p:has(> br:only-child)) {
		display: none;
	}
	.body :global(p + p) {
		margin-block-start: 1em;
	}
	.body :global(strong) {
		font-weight: 400;
		color: var(--charcoal);
	}
	.visit {
		align-self: center;
		padding: 12px 24px;
		font-size: 14.5px;
		line-height: 23.2px;
		letter-spacing: -0.29px;
		color: var(--charcoal);
	}
	.visit:hover {
		color: var(--gold-dark);
	}
	:global(.ccta .e:empty) {
		display: none;
	}
	@media (max-width: 1399.98px) {
		.image {
			padding-inline: 32px;
		}
	}
	@media (max-width: 809.98px) {
		.image {
			padding-inline: 12px;
		}
	}
</style>
