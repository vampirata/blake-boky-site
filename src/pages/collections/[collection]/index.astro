---
// One page per collection in collections.json. Two layouts:
//  - series overview (template "collection-detail"): intro, meta, feature
//    images, "The Works" with a live title search over works.json
//  - coming soon (template "collection-coming-soon"): placeholder with plate
//    image and an "In the meantime" grid of collections you can see now.
import Base from "../../../layouts/Base.astro";
import BackPill from "../../../components/BackPill.astro";
import Card from "../../../components/Card.astro";
import Img from "../../../components/Img.astro";
import { collections, worksIn, type Collection, type ImageRec } from "../../../lib/data";
import { url } from "../../../lib/site";
import { img } from "../../../lib/img";

export function getStaticPaths() {
	return collections.map((c) => ({ params: { collection: c.slug }, props: { col: c } }));
}

const { col } = Astro.props as { col: Collection };
const soon = !!col.comingSoon;

// Card links: the Andromeda card pointed at the Blake coming soon page on the
// live site, although /collections/andromeda is published.
const slugs = new Set(collections.map((c) => c.slug));
const soonSlugs = new Set(collections.filter((c) => c.comingSoon).map((c) => c.slug));
const slugOf = (target: string) => target.replace(/^\/collections\/?/, "").split("/")[0];
const fixTarget = (c: { title: string; target: string }) => {
	if (/^andromeda\b/i.test(c.title.trim())) return "/collections/andromeda";
	if (/^rethink\b/i.test(c.title.trim())) return "/collections/coming-soon-blake";
	return slugs.has(slugOf(c.target)) ? c.target : "/collections";
};

// ---------- Series overview data ----------
const metaEntries: [string, string][] = ((col.metaOrder as string[] | undefined) ?? Object.keys(col.meta ?? {}))
	.map((k) => [k, String(col.meta?.[k] ?? "").trim()] as [string, string])
	.filter(([, v]) => v !== "");

// Placeholder text left in the CMS ("... and continued into ect;;;") is cut at the unfinished clause.
const cleanHtml = (h: string) => h.replace(/\s+and continued into ect;+\s*$/i, ".").trim();
const intro = ((col.introBlocks ?? []) as { tag: string; html: string }[]).map((b) => ({ tag: b.tag, html: cleanHtml(b.html) }));
const leads = intro.filter((b) => b.tag === "p");
const notes = intro.filter((b) => b.tag !== "p");

// Feature images keep the live rows: grouped by their rendered row on the
// desktop capture, columns from their rendered width (2-up, 3-up or full).
type Row = { cols: number; items: ImageRec[] };
const ratioOf = (src: string) => img(src)?.ratio ?? 1;
// Live row heights at 1440 (620 for 2 up, 830 for 3 up, 480 full width) as a
// share of the row width: a row never grows taller than it was on the live site.
const ROW_CAP: Record<number, number> = { 1: 480 / 1440, 2: 620 / 1440, 3: 830 / 1440 };
const rows: Row[] = [];
for (const g of (col.gallery ?? []) as ImageRec[]) {
	const y = Math.round(g.rendered?.y ?? 0);
	const cols = Math.max(1, Math.round(1440 / (g.rendered?.width || 720)));
	const last = rows[rows.length - 1] as (Row & { y?: number }) | undefined;
	if (last && last.y === y) last.items.push(g);
	else rows.push(Object.assign({ cols, items: [g] }, { y }));
}

const cardByTarget = new Map(
	((col.workCards ?? []) as { target: string; date?: string; image?: ImageRec }[]).map((w) => [w.target.split("/").pop(), w])
);
const works = soon
	? []
	: worksIn(col.slug).map((w) => {
			const card = cardByTarget.get(w.slug);
			return {
				slug: w.slug,
				title: w.title.trim(),
				date: card?.date,
				image: card?.image?.src ?? w.images?.[0]?.src,
			};
		});

// ---------- Coming soon data ----------
const elsewhere = soon
	? ((col.elsewhere?.cards ?? []) as { title: string; date?: string; target: string; image?: ImageRec }[])
			.map((c) => ({ ...c, title: c.title.trim(), href: fixTarget(c) }))
			// "Collections you can see now" listed the in-preparation ones too.
			.filter((c) => !soonSlugs.has(slugOf(c.href)))
	: [];

// Per collection theme, measured on the live pages (1440, computed styles):
// Spirit sits on stone, Andromeda and Fragments on paper, the Boky series on ink.
type Theme = "stone" | "paper" | "ink";
const THEMES: Record<string, Theme> = {
	"spirit-collection": "stone",
	andromeda: "paper",
	fragments: "paper",
	"in-lucem": "ink",
	"figurative-poetry": "ink",
};
const theme: Theme = THEMES[col.slug] ?? "stone";
const NAV = { stone: "black", paper: "light", ink: "grey" } as const;
const BG = { stone: "var(--stone)", paper: "var(--paper)", ink: "var(--ink)" } as const;
// Works grid: live used 3 columns of 433px cards for these, 4 elsewhere; square
// frames on Andromeda and In Lucem, 9:16 elsewhere (shown here as 2:3 so the
// contained artwork is not lost in bars).
const THREE_UP = new Set(["andromeda", "in-lucem", "figurative-poetry"]);
const SQUARE = new Set(["andromeda", "in-lucem"]);
const gridCols = THREE_UP.has(col.slug) ? 3 : 4;
const cardRatio = SQUARE.has(col.slug) ? "1 / 1" : "2 / 3";
// Spirit's notes are small Inter; the Boky series set them as 26px Cormorant.
const bigNotes = col.slug !== "spirit-collection";
// Header to first block: Fragments has no blank lead line; Andromeda has no intro.
const bodyGap = col.slug === "fragments" ? 57 : col.slug === "andromeda" ? 159 : 107;

// Coming Soon Boky is the dark (ink) variant on the live site, Blake's is paper.
const soonDark = col.slug === "coming-soon-boky";
const soonBg = soonDark ? "var(--ink)" : "var(--paper-2)";

const pageTitle = soon
	? `Coming Soon: ${String(col.eyebrow ?? "").toLowerCase().replace(/\b\w/g, (m) => m.toUpperCase())}`
	: col.title;
const description = col.seo?.description;
const og = soon ? col.hero?.image?.src : (col.gallery?.[0]?.src ?? col.hero?.image?.src);
const ctaHref = (c: { target?: string; href: string }) => c.target ?? c.href;
---

{
	soon ? (
		<Base title={pageTitle} description={description} ogImage={og} nav={soonDark ? "grey" : "light"} bg={soonBg} fg={soonDark ? "var(--paper)" : "var(--ink)"}>
			<BackPill href="/collections" label="Collections" tone={soonDark ? "dark" : "light"} />
			<div class:list={["cs", soonDark && "cs--dark"]}>
				<header class="cs-head">
					<p class="cs-eyebrow" data-arrive>{col.eyebrow}</p>
					<h1 class="cs-title" data-arrive style="--d:1100ms">{col.title}</h1>
					{col.status && <p class="cs-tag" data-arrive style="--d:1200ms">{col.status}</p>}
				</header>

				<div class="cs-split">
					<div class="cs-text">
						{col.intro?.[0] && <p class="cs-lead" data-reveal>{col.intro[0]}</p>}
						{col.intro?.slice(1).map((t: string) => <p class="cs-note" data-reveal>{t}</p>)}
						<div class="cs-btns" data-reveal>
							{(col.ctas ?? []).map((c: { label: string; href: string; target?: string }, i: number) => (
								<a class:list={["cs-btn", i === 0 ? "cs-btn--main" : "cs-btn--ghost"]} href={url(ctaHref(c))}>
									{c.label}
								</a>
							))}
						</div>
					</div>
					{col.hero?.image?.src && (
						<div class="cs-plate">
							<Img src={col.hero.image.src} alt={col.hero.image.alt ?? ""} bg={soonBg} pos="50% 0%" sizes="(min-width: 810px) 46vw, 100vw" eager />
						</div>
					)}
				</div>
				<hr class="cs-rule" />

				{elsewhere.length > 0 && (
					<section class="cs-more" aria-labelledby="cs-more-h">
						<p class="cs-eyebrow">{col.elsewhere?.eyebrow}</p>
						<h2 class="cs-more-h" id="cs-more-h">
							{col.elsewhere?.heading}
						</h2>
						<ul class="cs-grid">
							{elsewhere.map((c) => (
								<li>
									<Card
										href={c.href}
										image={c.image?.src}
										title={c.title}
										date={c.date}
										ratio="4 / 5"
										bg={soonBg}
										tone={soonDark ? "dark" : "light"}
										sizes="(min-width: 1400px) 25vw, (min-width: 810px) 33vw, 100vw"
									/>
								</li>
							))}
						</ul>
					</section>
				)}
			</div>
		</Base>
	) : (
		<Base title={pageTitle} description={description} ogImage={og} nav={NAV[theme]} bg={BG[theme]} fg={theme === "paper" ? "var(--charcoal)" : "var(--paper)"}>
			<BackPill href="/collections" label="Collections" tone={theme === "paper" ? "light" : "dark"} />
			<div class:list={["cd", `cd--${theme}`, bigNotes && "cd--big-notes", gridCols === 3 && "cd--three"]} style={`--body-gap:${bodyGap}px`}>
				<header class="cd-head pad" data-arrive>
					<p class="cd-eyebrow">{col.eyebrow}</p>
					<h1 class="detail-title cd-title">{col.title}</h1>
				</header>

				<div class="cd-body">
					{(leads.length > 0 || notes.length > 0) && (
						<div class="cd-intro pad" data-reveal>
							{leads.map((b) => (
								<p class="intro-italic cd-lead" set:html={b.html} />
							))}
							{notes.length > 0 && (
								<div class="cd-notes">
									{notes.map((b) => (
										<p set:html={b.html} />
									))}
								</div>
							)}
						</div>
					)}

					{metaEntries.length > 0 && (
						<dl class="cd-meta pad" data-reveal>
							{metaEntries.map(([k, v]) => (
								<div class="cd-meta-i">
									<dt class="eyebrow">{k}</dt>
									<dd>{v}</dd>
								</div>
							))}
						</dl>
					)}

					{rows.length > 0 && (
						<div class="cd-feat">
							{rows.map((r) => (
								<div
									class:list={["cd-row", `cd-row--${r.cols}`]}
									style={`--n:${r.items.length};--sum:${r.items.reduce((a, g) => a + ratioOf(g.src), 0).toFixed(4)};--cap:${ROW_CAP[r.cols] ?? 0.4306}`}
								>
									{r.items.map((g) => (
										<Img
											src={g.src}
											alt={g.alt?.trim() ?? ""}
											bg={BG[theme]}
											class="cd-fig"
											style={`--grow:${ratioOf(g.src).toFixed(4)}`}
											sizes={`(min-width: 810px) ${Math.min(100, Math.ceil(ratioOf(g.src) * Math.min(1 / r.items.reduce((a, x) => a + ratioOf(x.src), 0), ROW_CAP[r.cols] ?? 0.4306) * 100))}vw, 100vw`}
										/>
									))}
								</div>
							))}
						</div>
					)}
				</div>

				{works.length > 0 && (
					<section class="cd-works" aria-labelledby="works-h" data-works>
						<div class="pad">
							<p class="eyebrow">{col.worksEyebrow ?? "THE WORKS"}</p>
							<h2 class="h2 cd-works-h" id="works-h">
								{col.worksHeading ?? col.title}
							</h2>
							<div class="cd-search">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<circle cx="11" cy="11" r="7" />
									<line x1="21" y1="21" x2="16.65" y2="16.65" />
								</svg>
								<label class="sr-only" for={`q-${col.slug}`}>
									Search works in {col.title}
								</label>
								<input id={`q-${col.slug}`} type="search" placeholder="Search…" autocomplete="off" enterkeyhint="search" data-q />
								<span class="cd-count" aria-live="polite" data-count />
							</div>
						</div>
						<ul class="cd-grid" data-grid>
							{works.map((w) => (
								<li data-title={w.title.toLowerCase()}>
									<Card
										href={`/collections/${col.slug}/${w.slug}`}
										image={w.image}
										title={w.title}
										date={w.date}
										ratio={cardRatio}
										bg={BG[theme]}
										tone={theme === "paper" ? "light" : "dark"}
										sizes={gridCols === 3 ? "(min-width: 1400px) 433px, (min-width: 810px) 50vw, 100vw" : "(min-width: 1400px) 25vw, (min-width: 810px) 50vw, 100vw"}
									/>
								</li>
							))}
						</ul>
						<p class="cd-empty pad" data-empty hidden>
							No pieces match your search.
						</p>
					</section>
				)}
			</div>
		</Base>
	)
}

<script>
	// Live title search (port of WorksSearchGrid). Without JS every card shows.
	document.querySelectorAll<HTMLElement>("[data-works]").forEach((root) => {
		const input = root.querySelector<HTMLInputElement>("[data-q]");
		const count = root.querySelector<HTMLElement>("[data-count]");
		const empty = root.querySelector<HTMLElement>("[data-empty]");
		const items = [...root.querySelectorAll<HTMLElement>("[data-grid] > li")];
		if (!input) return;
		const run = () => {
			const q = input.value.trim().toLowerCase();
			let n = 0;
			for (const li of items) {
				const show = !q || (li.dataset.title ?? "").includes(q);
				li.hidden = !show;
				if (show) {
					n++;
					// Cards revealed by a search are shown at once.
					li.querySelectorAll("[data-reveal], [data-split]").forEach((el) => el.classList.add("is-in"));
				}
			}
			// The live bar has no counter; it only appears while a search is active.
			if (count) count.textContent = q ? `${n} ${n === 1 ? "piece" : "pieces"}` : "";
			if (empty) empty.hidden = n !== 0;
		};
		input.addEventListener("input", run);
		input.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && input.value) {
				e.preventDefault();
				input.value = "";
				run();
			}
		});
	});
</script>

<style>
	/* ---------- Series overview ---------- */
	.cd {
		--c-eyebrow: var(--hairline);
		--c-title: var(--hairline);
		--c-body: var(--paper);
		--c-lead: var(--paper);
		--c-label: var(--paper);
		--c-value: var(--paper);
		--c-rule: var(--white);
		--c-works: var(--paper);
		--c-input: var(--white);
		display: flex;
		flex-direction: column;
		gap: 106px;
		max-inline-size: 1920px;
		margin-inline: auto;
		padding: 200px 0 110px;
		color: var(--c-body);
	}
	/* Colours measured per theme on the live pages. */
	.cd--paper {
		--c-eyebrow: var(--taupe);
		--c-title: var(--charcoal);
		--c-body: var(--taupe);
		--c-lead: #666666;
		--c-label: var(--taupe);
		--c-value: var(--charcoal);
		--c-rule: var(--grey-363);
		--c-works: var(--black);
		--c-input: var(--charcoal);
	}
	.cd--ink {
		--c-rule: #2a2a28;
	}
	.pad {
		padding-inline: var(--gutter);
	}
	.cd-eyebrow {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 12px;
		line-height: 1.6;
		letter-spacing: 1.8px;
		text-transform: uppercase;
		color: var(--c-eyebrow);
	}
	.cd-title {
		margin-block-start: 12px;
		color: var(--c-title);
	}
	.cd-body {
		display: flex;
		flex-direction: column;
		gap: 56px;
		/* Live spacing from the title to the first block differs per page. */
		margin-block-start: calc(var(--body-gap, 107px) - 106px);
	}
	.cd-intro {
		max-inline-size: calc(820px + 2 * var(--gutter));
	}
	.cd-lead {
		line-height: 1.35;
		color: var(--c-lead);
	}
	.cd-lead + .cd-lead {
		margin-block-start: 20px;
	}
	.cd-notes {
		display: flex;
		flex-direction: column;
		gap: 20px;
		font-weight: 300;
		font-size: 16px;
		line-height: 1.6;
		letter-spacing: -0.02em;
	}
	/* In Lucem and Figurative Poetry: notes in the display serif. */
	.cd--big-notes .cd-notes {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: 26px;
		line-height: 1.4;
		letter-spacing: -0.04em;
	}
	.cd-meta {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0 32px;
		margin: 0;
	}
	.cd-meta-i {
		border-block-start: 1px solid var(--c-rule);
		padding-block: 20px 0;
		min-block-size: 77px;
	}
	.cd-meta dt {
		color: var(--c-label);
	}
	.cd-meta dd {
		margin: 8px 0 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 22px;
		line-height: 1.3;
		letter-spacing: -0.44px;
		color: var(--c-value);
	}
	.cd-feat {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	/* Each row keeps the live rhythm (2 up, 3 up, full width) but every image
	   takes a width in proportion to its own ratio, so the row shares one
	   height and shows each artwork whole with no bars. */
	.cd-feat {
		container-type: inline-size;
	}
	.cd-row {
		/* Shared row height: what fills the width, capped at the live height. */
		--h: min(calc((100cqw - (var(--n) - 1) * 20px) / var(--sum)), calc(var(--cap) * 100cqw));
		display: flex;
		justify-content: center;
		gap: 20px;
	}
	.cd-row > :global(.cd-fig) {
		flex: none;
		inline-size: calc(var(--grow) * var(--h));
	}
	.cd-works .eyebrow {
		color: var(--c-label);
	}
	.cd-works-h {
		margin-block-start: 2px;
		color: var(--c-works);
	}
	.cd-search {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-block: 24px;
		padding: 0 14px 0 12px;
		block-size: 40px;
		border-radius: 10px;
		/* Keep the field clear of the fixed bar and back pill when focused. */
		scroll-margin-block: 160px 40vh;
		background: rgba(187, 187, 187, 0.15);
		color: var(--c-input);
		opacity: 0.85;
		transition: opacity 200ms var(--ease-link);
	}
	.cd-search:focus-within {
		opacity: 1;
		outline: 1px solid var(--gold-light);
		outline-offset: 2px;
	}
	.cd--paper .cd-search:focus-within {
		outline-color: var(--gold-dark);
	}
	html:not(.js) .cd-search {
		display: none;
	}
	.cd-search svg {
		flex: none;
		opacity: 0.6;
	}
	.cd-search input {
		flex: 1;
		min-inline-size: 0;
		block-size: 100%;
		background: transparent;
		border: 0;
		outline: 0;
		border-radius: 0;
		scroll-margin-block: 172px 40vh;
		color: var(--c-input);
		/* 16px on phones so iOS does not zoom into the field. */
		font: 400 14px/1 var(--font-body);
		-webkit-appearance: none;
		appearance: none;
	}
	.cd-search input::placeholder {
		color: currentColor;
		opacity: 0.6;
	}
	.cd-search input::-webkit-search-cancel-button {
		-webkit-appearance: none;
	}
	.cd-count {
		flex: none;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.6;
	}
	.cd-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 130px 0;
	}
	/* Andromeda, In Lucem, Figurative Poetry: three 433px cards, 47px apart. */
	.cd--three .cd-grid {
		grid-template-columns: repeat(3, minmax(0, 433px));
		column-gap: 47px;
	}
	.cd-grid > li {
		min-inline-size: 0;
	}
	.cd-grid > li[hidden] {
		display: none;
	}
	.cd-empty {
		/* Holds some height so the footer does not jump up under the cursor. */
		min-block-size: 40vh;
		padding-block-start: 16px;
		font-size: 14px;
		color: var(--c-body);
	}
	@media (max-width: 1399.98px) {
		.cd {
			padding-inline: 32px;
		}
		.cd .pad {
			padding-inline: 0;
		}
		.cd-intro {
			max-inline-size: none;
		}
		.cd--big-notes .cd-notes {
			font-size: 21px;
			letter-spacing: -0.04em;
		}
		.cd-grid,
		.cd--three .cd-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 0;
		}
	}
	@media (max-width: 809.98px) {
		.cd {
			padding: 200px 0 80px;
		}
		.cd .pad {
			padding-inline: 12px;
		}
		.cd--big-notes .cd-notes {
			font-size: 19px;
		}
		.cd-meta {
			grid-template-columns: minmax(0, 1fr);
		}
		/* Live phone layout overflowed the row of 3 off screen. Stack every
		   feature image full width at its own ratio instead. */
		.cd-row {
			flex-direction: column;
		}
		.cd-row > :global(.cd-fig) {
			inline-size: 100%;
		}
		.cd-search input {
			font-size: 16px;
		}
		.cd-grid,
		.cd--three .cd-grid {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 60px;
		}
	}

	/* ---------- Coming soon ---------- */
	.cs {
		--s-eyebrow: var(--taupe-2);
		--s-title: var(--ink);
		--s-tag: var(--gold-dark);
		--s-lead: var(--charcoal);
		--s-note: var(--taupe);
		--s-main: var(--charcoal);
		--s-ghost-line: rgba(28, 26, 23, 0.15);
		--s-ghost: var(--taupe);
