---
// Collections index: Arrive header, 12 collection cards, pre-footer CTA band.
// Template "collections" in docs/design-spec.md.
// Grey mode (both artists, see docs/rebuild-rules.md "Colour modes"): stone.
import Base from "../../layouts/Base.astro";
import ArriveHeader from "../../components/ArriveHeader.astro";
import Card from "../../components/Card.astro";
import CtaBand from "../../components/CtaBand.astro";
import page from "../../content/data/collections-index.json";
import { collections, cleanTitle } from "../../lib/data";

type IndexCard = { title: string; date?: string; target: string; image?: { src: string } };

// Live links fixed: the Andromeda card pointed at the Blake coming soon page
// although /collections/andromeda is published. Any target that is not a
// collection page falls back to the index.
const slugs = new Set(collections.map((c) => c.slug));
const fixTarget = (c: IndexCard) => {
	if (/^andromeda\b/i.test(c.title.trim())) return "/collections/andromeda";
	// Rethink is Blake's (2005 to present) and has no page yet; live sent it to Boky's In Lucem.
	if (/^rethink\b/i.test(c.title.trim())) return "/collections/coming-soon-blake";
	const slug = c.target.replace(/^\/collections\/?/, "").split("/")[0];
	return slugs.has(slug) ? c.target : "/collections";
};
const cards = (page.cards as IndexCard[]).map((c) => ({ ...c, title: c.title.trim(), href: fixTarget(c) }));
const title = cleanTitle(page.seo?.title, page.heading);
---

<Base title={title} description={page.seo?.description} ogImage={page.cta?.image?.src} nav="black" bg="var(--stone)" fg="var(--stone-text)" smooth>
	<div class="head">
		<ArriveHeader title={page.heading} />
	</div>
	<section class="grid-wrap" aria-label="All collections">
		<ul class="grid">
			{
				cards.map((c) => (
					<li>
						<Card href={c.href} image={c.image?.src} title={c.title} date={c.date} ratio="1 / 1" ratioTablet="9 / 16" ratioPhone="9 / 16" bg="var(--stone)" />
					</li>
				))
			}
		</ul>
	</section>
	{page.cta?.image?.src && <CtaBand image={page.cta.image.src} heading={page.cta.heading} pos="50% 60%" />}
</Base>

<style>
	.head :global(.arrive-title) {
		color: var(--paper);
	}
	.head :global(.rule) {
		background: var(--stone-rule);
	}
	.grid-wrap {
		padding: 50px var(--gutter-grid) 150px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 100px 0;
	}
	.grid > li {
		min-inline-size: 0;
	}
	@media (max-width: 1399.98px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 809.98px) {
		.grid-wrap {
			padding: 50px 0 150px;
		}
		.grid {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 60px;
		}
	}
</style>
