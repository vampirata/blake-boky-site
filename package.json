{
	"name": "blake-boky-site",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev --port 4400",
		"images": "node scripts/optimize-images.mjs",
		"build": "node scripts/optimize-images.mjs && astro build && node scripts/postbuild.mjs",
		"preview": "astro preview --port 4401",
		"check": "astro check",
		"deploy": "pnpm build && npx wrangler pages deploy dist --project-name blake-boky --branch main"
	},
	"dependencies": {
		"@fontsource/cormorant-garamond": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"astro": "^5.18.2",
		"lenis": "^1.3.27",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"playwright": "1.56.1",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"typescript": "^7.0.2"
	}
}
