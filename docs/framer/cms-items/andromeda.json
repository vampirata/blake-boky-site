    {
      "id": "GWijZ14VN",
      "draft": false,
      "fields": {
        "Title": "Andromeda Devorah ",
        "Slug": "andromeda-devorah",
        "Name": "Andromeda Devorah ",
        "Content": [
          {
            "type": "TextBlock",
            "id": "v:GWijZ14VN/ZhdDzuNaW:0",
            "attributes": {
              "tag": "p"
            },
            "children": [
              {
                "type": "TextRun",
                "id": "v:GWijZ14VN/ZhdDzuNaW:0:0",
                "attributes": {
                  "text": "An original sculpture entitled “Andromeda” was created by hand, in wax, using the traditional methods of the artist, and cast in bronze. “Andromeda” was then digitally scanned and uploaded to the CAD software: “ZBrush”. In this program a modified digital sculpture entitled “Devorah” was created from the original scan. This digital file was altered by removing some of the surface of the sculpture as well as by adding an interior structure. The altered digital file was then printed on a SLS 3D powder bed printer in a wax polymer and cast in bronze using the lost wax process."
                }
              }
            ]
          }
        ],
        "Gallery": "[\"https://framerusercontent.com/images/lcaHx3z1ozhy4pC9knl473Hiji4.jpg\",\"https://framerusercontent.com/images/8jIdbfTvl9MpbG7Vn92cFlOXRsA.jpg\",\"https://framerusercontent.com/images/K28Wtqh151weamF3AqNONt91lM.jpg\",\"https://framerusercontent.com/images/QhLxOdJXw8SMxxNc8eZpQUdJfgk.jpg\"]",
