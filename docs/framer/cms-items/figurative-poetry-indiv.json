    {
      "id": "CV8b2nG0K",
      "draft": false,
      "fields": {
        "Title": "Damaged ",
        "Slug": "damaged",
        "Content": [
          {
            "type": "TextBlock",
            "id": "v:CV8b2nG0K/spJHtBo4G:0",
            "attributes": {
              "tag": "p"
            },
            "children": [
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:0",
                "attributes": {
                  "text": "From Boky’s "
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:1",
                "attributes": {
                  "text": "Figurative Poetry Collection",
                  "italic": true
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:2",
                "attributes": {
                  "text": ", this bronze was directly inspired by a poem entitled "
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:3",
                "attributes": {
                  "text": "Mea Culpa taken from ",
                  "italic": true
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:4",
                "attributes": {
                  "text": "Paul Géraldy’s book "
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:5",
                "attributes": {
                  "text": "Toi et Moi.  ",
                  "italic": true
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:6",
                "attributes": {
                  "text": "It h"
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:7",
                "attributes": {
                  "text": "as",
                  "italic": true
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:8",
                "attributes": {
                  "text": " been a source of inspiration for Boky for many years.  While studying in Florence, she found an old, dilapidated copy of the book in a basement.  It inspired a series of paintings, as well as, a series of photos entitled "
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:0:9",
                "attributes": {
                  "text": "Le Roi est Mort.",
                  "italic": true
                }
              }
            ]
          },
          {
            "type": "TextBlock",
            "id": "v:CV8b2nG0K/spJHtBo4G:1",
            "attributes": {
              "tag": "p"
            },
            "children": [
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:1:0",
                "attributes": {
                  "text": " "
                }
              }
            ]
          },
          {
            "type": "TextBlock",
            "id": "v:CV8b2nG0K/spJHtBo4G:2",
            "attributes": {
              "tag": "p"
            },
            "children": [
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:2:0",
                "attributes": {
                  "text": "The sculpture exists in two editions, one has the excerpt of Géraldy’s poem in the interior of the female figure, while the other edition does not. "
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:2:1",
                "attributes": {
                  "text": "  ",
                  "italic": true
                }
              }
            ]
          },
          {
            "type": "TextBlock",
            "id": "v:CV8b2nG0K/spJHtBo4G:3",
            "attributes": {
              "tag": "p"
            },
            "children": [
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/spJHtBo4G:3:0",
                "attributes": {
                  "text": "They are either gold leafed or platinum leafed."
                }
              }
            ]
          }
        ],
        "Content 2": [
          {
            "type": "TextBlock",
            "id": "v:CV8b2nG0K/bxf47LFuI:0",
            "attributes": {
              "tag": "p"
            },
            "children": [
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/bxf47LFuI:0:0",
                "attributes": {
                  "text": "Mea Culpa",
                  "italic": true
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/bxf47LFuI:0:1",
                "attributes": {
                  "text": ":                        "
                }
              },
              {
                "type": "TextRun",
                "id": "v:CV8b2nG0K/bxf47LFuI:0:2",
                "attributes": {
                  "text": "Au fond, vois-tu, mon erreur, ",
